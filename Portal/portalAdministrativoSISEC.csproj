<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
    <ScopedCssEnabled>true</ScopedCssEnabled>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="CheckForNpm" BeforeTargets="NpmInstall" Condition="'$(SkipNpmBuild)' != 'true'">
    <Exec Command="npm -v" ContinueOnError="true">
        <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Debe instalar NPM para compilar este proyecto" />
  </Target>

  <Target Name="NpmInstall" BeforeTargets="BuildCSS" Inputs="package.json" Outputs="$(NpmLastInstall)" Condition="'$(SkipNpmBuild)' != 'true'">
      <Exec Command="npm install" />
      <Touch Files="$(NpmLastInstall)" AlwaysCreate="true" />
  </Target>

  <Target Name="Tailwind" BeforeTargets="PreBuildEvent" Condition="'$(SkipNpmBuild)' != 'true'">
      <Exec Command="npm run build:css" />
  </Target>

  <Target Name="TailwindDebug" BeforeTargets="Compile" Condition="'$(Configuration)' == 'Debug' And '$(SkipNpmBuild)' != 'true'">
      <Exec WorkingDirectory="$(ProjectDir)" Command="npm run build:css" />
  </Target>

  <Target Name="TailwindRelease" BeforeTargets="Compile" Condition="'$(Configuration)' == 'Release' And '$(SkipNpmBuild)' != 'true'">
      <Exec EnvironmentVariables="NODE_ENV=production" Command="npm run release:css" />
  </Target>
  <ItemGroup>
    <Content Remove="wwwroot\assets\icono-error.svg" />
    <Content Remove="wwwroot\img\79662242firma.jpg" />
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="portalAdministrativoSISEC.Application\**\*.cs" />
    <Compile Remove="portalAdministrativoSISEC.Tests\**\*.cs" />
    <EmbeddedResource Remove="artifacts\**" />
    <Content Remove="artifacts\**\*" />
    <None Remove="artifacts\**\*" />
    <Content Remove="portalAdministrativoSISEC.Application\**\*" />
    <Content Remove="portalAdministrativoSISEC.Tests\**\*" />
    <None Remove="portalAdministrativoSISEC.Application\**\*" />
    <None Remove="portalAdministrativoSISEC.Tests\**\*" />
  </ItemGroup>
  
  <ItemGroup>
    <Watch Include="./Styles/tailwind.css" Exclude="./wwwroot/**/*;obj\**\*;bin\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="copilot-instructions.md" />
