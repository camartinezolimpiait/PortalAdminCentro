@page "/Residence"
@layout SingleLayout
@inject NavigationManager UriHelper
@using Microsoft.Extensions.Configuration
@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms
@using Newtonsoft.Json;
@using Microsoft.JSInterop
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor httpContextAccessor

<div class="formulario-2 ">
    <h3>Datos de residencia</h3>
    <form>
        <div class="field">
            <label class="texto-label col-form-label">Dirección de residencia</label>
            <input class="form-control" type="text" id="dirResidencia" name="dirResidencia" />
        </div>
        <div class="field">
            <label class="texto-label">Departamento de residencia</label>
            <input type="text" id="depResidencia" name="depResidencia" />
        </div>
        <div class="field">
            <label class="texto-label">Municipio de residencia</label>
            <input type="text" id="munResidencia" name="munResidencia" />
        </div>
        <h3>Datos de salud</h3>
        <div class="field">
            <label class="texto-label">EPS del aspirante</label>
            <input type="text" id="epsAspirante" name="epsAspirante" />
        </div>
        <div>
            <button type="button" class="boton-primario" @onclick="@Siguiente">Finalizar enrolamiento</button>
        </div>
    </form>
</div>
@code {

    private string apiName = null;
    bool showModal = true;
    bool showModalValida = false;
    private string message = null;
    private string typeAlert = null;
    private ApplicationSevice menuservice = new ApplicationSevice();

    RespGeneralModel RespGeneralRegistroPin = new RespGeneralModel();
    void Siguiente()
    {
        registraPinPrincipal();
        UriHelper.NavigateTo("Success");
    }


    private async void registraPinPrincipal()
    {

        PinPrincipalProceso pinPrincipal = new PinPrincipalProceso();

        pinPrincipal.DescripcionPeticion = "Transacción Exitosa";
        pinPrincipal.IdCentro = Convert.ToInt32(menuservice.entradaEnrolamiento.IdCentro);
        pinPrincipal.IdEstadoUsoPin = 1;
        pinPrincipal.IdOrigenPin = menuservice.idOrigenPin;
        pinPrincipal.IdProceso = menuservice.respuestaEnrolarPersona.IdProcesoCRCCEA;
        pinPrincipal.IdTipoIdentificacion = Convert.ToInt32(menuservice.entradaEnrolamiento.TipoDocumentoId);
        pinPrincipal.IntentoDiario = 1;
        pinPrincipal.NumeroDocumento = menuservice.entradaEnrolamiento.NumeroDocumento;
        pinPrincipal.Pin = menuservice.entradaEnrolamiento.NumeroPin;
        pinPrincipal.ValorPinPrincipal = menuservice.entradaEnrolamiento.ValorPin;
        pinPrincipal.Servidor = "N/A";
        pinPrincipal.CodigoProcesamiento = 0;

        Http = new HttpClient();
        apiName = "CrearPinPrincipalProcesoSP";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);


        var stringContent = new StringContent(JsonConvert.SerializeObject(pinPrincipal), System.Text.Encoding.UTF8, "application/json");
        var response = await Http.PostAsync(apiName, stringContent);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            RespGeneralRegistroPin = JsonConvert.DeserializeObject<RespGeneralModel>(content);
            if (!RespGeneralRegistroPin.Respuesta)
            {
                typeAlert = "Danger";
                message = RespGeneralRegistroPin.RespuestaTexto;
                showModalValida = true;
                showModal = false;
            }

            StateHasChanged();
        }
        else
        {
            RespGeneralRegistroPin.Respuesta = true;
            StateHasChanged();
        }
    }
}