@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Globalization
@using portalAdministrativoSISEC.Enum.PortalAdministrativo
@using portalAdministrativoSISEC.Pages.Facturacion.Common
@using portalAdministrativoSISEC.Pages.Facturacion.Modal
@using portalAdministrativoSISEC.Pages.Facturacion.Models

@* Inicio código generado por GitHub Copilot *@

<SpinLoader IsLoading="IsLoading">
    <LoadingTemplate>
        <div style="height:100%;display:flex">
            <br />
            <Circle Center="true" Color="var(--color-azul-600)"></Circle>
        </div>
    </LoadingTemplate>
    <ContentTemplate>
        @if (!HasFE)
        {
            <h3>Consulta de solicitudes de factura electrónica</h3>
            <p class="paragraph">
                Olimpia IT ahora ofrece un servicio de facturación que le permite emitir las facturas electrónicas de sus procesos de certificación automáticamente. Para más información o activación del servicio, comuníquese por los canales de atención para CRC o CEA.
            </p>
        }
        else
        {
                <EditForm EditContext="@EditContext" id="ConsultarFacturacion" style="max-width: 99%" OnValidSubmit="OnConsultarAsync" OnFieldChanged="HandleFieldChanged">
                    <DataAnnotationsValidator />
                    <div class="mx-auto w-full max-w-full">

                        <h3>Consulta de solicitudes de factura electrónica</h3>

                        <div class="mb-6">
                            <Estado IdRunt="@(GetCentroResponse.CodigoRUNT?.ToString() ?? "")" Proveedor="false"></Estado>
                        </div>

                        @* Sistema de Pestañas *@
                        <div role="tablist" class="tabs tabs-border tabs-lg mb-3">
                            @foreach (var estadoEnum in new[] {
                                                EnumEstadoFacturacionElectronica.PorRevisar,
                                                EnumEstadoFacturacionElectronica.Facturadas,
                                                EnumEstadoFacturacionElectronica.Anuladas,
                                                EnumEstadoFacturacionElectronica.EnCola
                                                })
                            {
                                var estadoId = (int)estadoEnum;
                                var contador = Contadores.ContainsKey(estadoId) ? Contadores[estadoId] : 0;
                                var esActiva = FiltroEstado == estadoId;

                                <NavLink class="tab no-underline font-semibold text-lg"
                                         activeClass="tab-active"
                                         href="@($"/ConsultarFacturacion/{estadoEnum}")"
                                         role="tab">
                                    @GetEstadoDisplayName(estadoEnum)@(esActiva ? $" ({contador})" : "")
                                </NavLink>
                            }
                        </div>

                        @* Mensaje informativo *@
                        <div class="flex w-full items-center gap-3 mb-2 ml-2 mt-4">
                            <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                                <mask id="mask0_11700_28011" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="18" height="18">
                                    <rect width="18" height="18" fill="#D9D9D9" />
                                </mask>
                                <g mask="url(#mask0_11700_28011)">
                                    <path d="M8.25049 12.7499H9.75049V8.24985H8.25049V12.7499ZM9.00049 6.74985C9.21299 6.74985 9.39111 6.67798 9.53486 6.53423C9.67861 6.39048 9.75049 6.21235 9.75049 5.99985C9.75049 5.78735 9.67861 5.60923 9.53486 5.46548C9.39111 5.32173 9.21299 5.24985 9.00049 5.24985C8.78799 5.24985 8.60986 5.32173 8.46611 5.46548C8.32236 5.60923 8.25049 5.78735 8.25049 5.99985C8.25049 6.21235 8.32236 6.39048 8.46611 6.53423C8.60986 6.67798 8.78799 6.74985 9.00049 6.74985ZM9.00049 16.4999C7.96299 16.4999 6.98799 16.303 6.07549 15.9092C5.16299 15.5155 4.36924 14.9811 3.69424 14.3061C3.01924 13.6311 2.48486 12.8374 2.09111 11.9249C1.69736 11.0124 1.50049 10.0374 1.50049 8.99985C1.50049 7.96235 1.69736 6.98735 2.09111 6.07485C2.48486 5.16235 3.01924 4.3686 3.69424 3.6936C4.36924 3.0186 5.16299 2.48423 6.07549 2.09048C6.98799 1.69673 7.96299 1.49986 9.00049 1.49986C10.038 1.49986 11.013 1.69673 11.9255 2.09048C12.838 2.48423 13.6317 3.0186 14.3067 3.6936C14.9817 4.3686 15.5161 5.16235 15.9099 6.07485C16.3036 6.98735 16.5005 7.96235 16.5005 8.99985C16.5005 10.0374 16.3036 11.0124 15.9099 11.9249C15.5161 12.8374 14.9817 13.6311 14.3067 14.3061C13.6317 14.9811 12.838 15.5155 11.9255 15.9092C11.013 16.303 10.038 16.4999 9.00049 16.4999ZM9.00049 14.9999C10.6755 14.9999 12.0942 14.4186 13.2567 13.2561C14.4192 12.0936 15.0005 10.6749 15.0005 8.99985C15.0005 7.32485 14.4192 5.90611 13.2567 4.7436C12.0942 3.5811 10.6755 2.99985 9.00049 2.99985C7.32549 2.99985 5.90674 3.5811 4.74424 4.7436C3.58174 5.90611 3.00049 7.32485 3.00049 8.99985C3.00049 10.6749 3.58174 12.0936 4.74424 13.2561C5.90674 14.4186 7.32549 14.9999 9.00049 14.9999Z" fill="#5E5E5E" />
                                </g>
                            </svg>
                            <p class="max-w-full text-gray-700 mb-0">Selecciona un rango de fechas válido y usa los filtros para buscar por documento, cliente o PIN</p>
                        </div>

                        @* Formulario de Filtros *@
                        <AntiforgeryToken />

                            <div class="mb-2 block md:flex items-end gap-2">
                                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-8 gap-2 items-end">
                                    @* Filtro de Fechas *@
                            <div class="col-span-2 w-full grid grid-cols-2 gap-1 bg-neutral-100 p-2 rounded-md border border-neutral-300 items-end">
                                        <div>
                                            <div>
                                        <ValidationMessage For="@(() => FiltrosConsultaFacturacion.FechaDesde)" class="text-xs block text-rojo-500" />
                                            </div>
                                            <label for="fechaDesde" class="text-sm">Desde</label>
                                            <InputDate id="fechaDesde"
                                                       @bind-Value="FiltrosConsultaFacturacion.FechaDesde"
                                                       max='@DateTime.Today.ToString("yyyy-MM-dd")' class="h-[38px]"/>
                                        </div>

                                        <div>
                                            <div>
                                                <ValidationMessage For="@(() => FiltrosConsultaFacturacion.FechaHasta)" class="text-xs block text-rojo-500" />
                                            </div>
                                            <label for="fechaHasta" class="text-sm">Hasta</label>
                                            <InputDate id="fechaHasta"
                                                       @bind-Value="FiltrosConsultaFacturacion.FechaHasta" class="h-[38px]"/>
                                        </div>
                                    </div>

                                    @* Filtro Tipo de Documento y Número *@
                            <div class="col-span-3 md:col-start-3 w-full grid grid-cols-2 gap-1 bg-neutral-100 p-2 rounded-md border border-neutral-300 items-end">
                                        <div>
                                            <label for="tipoDocumento" class="text-sm">Tipo</label>
                                            <InputSelect id="tipoDocumento" @bind-Value="FiltrosConsultaFacturacion.TipoDocumento" class="h-[38px]">
                                                <option value="">Todos</option>
                                                @foreach (var doc in ListaDocumentos?? [])
                                                {
                                                    <option value="@doc.IdTipoSisec">@doc.Nombre</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div>
                                            <div>
                                                <ValidationMessage For="@(() => FiltrosConsultaFacturacion.NumeroDocumento)" class="text-xs block text-rojo-500" />
                                            </div>
                                            <label for="numeroDocumento" class="text-sm">No. de documento</label>
                                            <input type="text"
                                                   id="numeroDocumento"
                                                   class="input h-[38px]"
                                                   autocomplete="off"
                                                   value="@FiltrosConsultaFacturacion.NumeroDocumento"
                                                   maxlength="@(DocumentoFacturacionHelper.GetMaxLength(FiltrosConsultaFacturacion.TipoDocumento) == int.MaxValue ? "524288" : DocumentoFacturacionHelper.GetMaxLength(FiltrosConsultaFacturacion.TipoDocumento).ToString())"
                                                   inputmode="@DocumentoFacturacionHelper.GetInputMode(FiltrosConsultaFacturacion.TipoDocumento)"
                                                   placeholder="@(string.IsNullOrEmpty(FiltrosConsultaFacturacion.TipoDocumento) ? "Buscar por documento" : "Búsqueda parcial permitida")"
                                                   @oninput="OnNumeroDocumentoInput" />
                                        </div>
                                    </div>

                                    @* Filtro Nombre del Cliente *@
                                    <div class="col-span-2 md:col-start-6 w-full bg-neutral-100 p-2 rounded-md border border-neutral-300">
                                        <div>
                                            <ValidationMessage For="@(() => FiltrosConsultaFacturacion.NombreCliente)" class="text-xs block text-rojo-500" />
                                        </div>
                                        <label for="nombreCliente" class="text-sm">Nombre del cliente pagador</label>
                                        <InputText id="nombreCliente"
                                                   class="input h-[38px]"
                                                   @bind-Value="FiltrosConsultaFacturacion.NombreCliente"
                                                   placeholder="Buscar por nombre" />
                                    </div>

                                    @* Filtro PIN *@
                                    <div class="md:col-start-8 w-full bg-neutral-100 p-2 rounded-md border border-neutral-300">
                                        <div>
                                            <ValidationMessage For="@(() => FiltrosConsultaFacturacion.PIN)" class="text-xs block text-rojo-500" />
                                        </div>
                                        <label for="pin" class="text-sm">PIN</label>
                                        <input type="text"
                                               id="pin"
                                               maxlength="15"
                                               class="input h-[38px]"
                                               autocomplete="off"
                                               @bind-value="FiltrosConsultaFacturacion.PIN"
                                               @bind-value:event="oninput"
                                               placeholder="Buscar PIN" />
                                    </div>
                     </div>

                    <div class="flex justify-end mt-2">
                        <button type="submit" class="boton-primario m-0 w-full md:w-[110px] xl:flex-1 disabled:cursor-not-allowed" >Consultar</button>
                    </div>
                </div>

            <section class="flex justify-end gap-2">
                @* Inicio código generado por GitHub Copilot - Exportar selección *@
                @if (HaySeleccionados)
                {
                    <button type="button" class="boton-secundario m-0" @onclick="ExportarSeleccionAsync">
                        Descargar selección (CSV)
                    </button>
                }
                @* Fin código generado por GitHub Copilot - Exportar selección *@
                @* Inicio código generado por GitHub Copilot - Botón anular con ícono *@
                @if (FiltroEstado == (int)EnumEstadoFacturacionElectronica.PorRevisar)
                {
                    <button type="button" class="boton-primario m-0 btn-red-500 flex items-center gap-2 w-[110px] text-white" @onclick="MostrarModalConfirmacion" disabled="@(!HaySeleccionados)">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16.5 17.75L15.2708 16.5208C15.1319 16.5625 14.9965 16.5972 14.8646 16.625C14.7326 16.6528 14.5903 16.6667 14.4375 16.6667H4.4375C3.74306 16.6667 3.15278 16.4236 2.66667 15.9375C2.18056 15.4514 1.9375 14.8611 1.9375 14.1667V11.6667H4.4375V5.6875L0 1.25L1.1875 0.0625L17.6875 16.5625L16.5 17.75ZM4.4375 15H13.75L12.0833 13.3333H3.60417V14.1667C3.60417 14.4028 3.68403 14.6007 3.84375 14.7604C4.00347 14.9201 4.20139 15 4.4375 15ZM16.9375 13.4792L15.2708 11.8125V2.5H5.95833L4.4375 0.979167V0L5.6875 1.25L6.9375 0L8.1875 1.25L9.4375 0L10.6875 1.25L11.9375 0L13.1875 1.25L14.4375 0L15.6875 1.25L16.9375 0V13.4792ZM6.10417 11.6667H10.4167L6.10417 7.35417V11.6667ZM9.33333 5.83333L7.66667 4.16667H11.9375V5.83333H9.33333ZM11.8333 8.33333L10.1667 6.66667H11.9375V8.33333H11.8333ZM13.6042 8.33333C13.3681 8.33333 13.1701 8.25347 13.0104 8.09375C12.8507 7.93403 12.7708 7.73611 12.7708 7.5C12.7708 7.26389 12.8507 7.06597 13.0104 6.90625C13.1701 6.74653 13.3681 6.66667 13.6042 6.66667C13.8403 6.66667 14.0382 6.74653 14.1979 6.90625C14.3576 7.06597 14.4375 7.26389 14.4375 7.5C14.4375 7.73611 14.3576 7.93403 14.1979 8.09375C14.0382 8.25347 13.8403 8.33333 13.6042 8.33333ZM13.6042 5.83333C13.3681 5.83333 13.1701 5.75347 13.0104 5.59375C12.8507 5.43403 12.7708 5.23611 12.7708 5C12.7708 4.76389 12.8507 4.56597 13.0104 4.40625C13.1701 4.24653 13.3681 4.16667 13.6042 4.16667C13.8403 4.16667 14.0382 4.24653 14.1979 4.40625C14.3576 4.56597 14.4375 4.76389 14.4375 5C14.4375 5.23611 14.3576 5.43403 14.1979 5.59375C14.0382 5.75347 13.8403 5.83333 13.6042 5.83333Z" fill="white" />
                        </svg>
                        Anular
                    </button>
                }
            </section>

                        <ModalFacturacion MostrarModal="@MostrarModal" OnAceptar="@ConfirmarAnulacion" OnCancelar="@CerrarModal" OnCerrar="CerrarModal"
                                      OnAceptarAnulacion="CerrarModal" Total="Total" TotalExitosos="TotalExitosos" />
                        @* Fin código generado por GitHub Copilot - Botón anular con ícono *@

            @* Encabezado de Resultados *@

                        @* Grid de Resultados *@
                        <figure class="relative m-0 w-full max-w-full">
                            @if (SinResultados)
                            {
                                @* Estado vacío *@
                                <div class="w-full max-w-full rounded-md bg-gray-50 p-8" style="height: 450px;">
                                    <div class="mx-auto flex h-full max-w-2xl flex-col items-center justify-center text-center gap-3">

                                        @if (BusquedaManualRealizada)
                                        {
                                            <div class="h-16 w-16">
                                            @* Placeholder para ícono *@
                                                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="42" viewBox="0 0 56 42" fill="none">
                                                    <path d="M7.39104 38.7727C8.48786 40.221 10.2195 41.0187 12.266 41.0187H42.4735C46.4066 41.0187 50.3062 38.0481 51.3497 34.2571L55.739 18.3271C56.2819 16.3555 55.9729 14.4729 54.8702 13.0246C53.7665 11.5763 52.0339 10.7796 49.9883 10.7796H46.9832L46.3247 8.16346C45.6415 5.43967 42.0124 3.30724 38.0645 3.30724H26.9679C24.0734 3.30724 22.0959 2.7149 21.624 2.37924C20.3811 0.116494 14.8447 0 13.7261 0H6.54893C4.53891 0 2.753 0.787815 1.52093 2.22029C0.28886 3.65179 -0.22549 5.53346 0.091413 7.61752L6.34852 36.2938C6.48772 37.1991 6.8372 38.0422 7.39104 38.7727ZM52.5137 14.8194C53.0438 15.5154 53.1741 16.4819 52.8829 17.5402L48.4946 33.4713C47.8105 35.9571 45.0531 38.058 42.4735 38.058H12.266C11.1682 38.058 10.2757 37.6769 9.75152 36.9858C9.2273 36.2938 9.10291 35.3312 9.40006 34.2749L12.418 23.5555C13.118 21.0696 15.8911 18.9688 18.4728 18.9688H28.0993C31.5645 18.9688 35.4651 17.714 36.2134 15.3209C36.4069 14.848 38.4406 13.7413 41.504 13.7413H49.9873C51.0881 13.7413 51.9845 14.1244 52.5137 14.8194ZM3.76591 4.15034C4.42637 3.38326 5.41558 2.95974 6.54991 2.95974H13.7271C16.6217 2.95974 18.5991 3.55208 19.071 3.88872C20.315 6.15147 25.8494 6.26796 26.9679 6.26796H38.0655C40.7734 6.26796 43.1438 7.64911 43.4538 8.88414L43.9296 10.7786H41.505C38.0388 10.7786 34.1392 12.0334 33.3909 14.4265C33.1964 14.8994 31.1627 16.0061 28.1003 16.0061H18.4738C14.5455 16.0061 10.6331 18.9688 9.56789 22.7509L7.79778 29.0405L3.00277 7.07849C2.83396 5.95797 3.10545 4.91742 3.76591 4.15034Z" fill="#ACACAC" />
                                                    <path d="M52.5137 14.8194C53.0438 15.5154 53.1741 16.4819 52.8829 17.5402L48.4946 33.4713C47.8105 35.9571 45.0531 38.058 42.4735 38.058H12.266C11.1682 38.058 10.2757 37.6769 9.75152 36.9858C9.2273 36.2938 9.10291 35.3312 9.40006 34.2749L12.418 23.5555C13.118 21.0696 15.8911 18.9688 18.4728 18.9688H28.0993C31.5645 18.9688 35.4651 17.714 36.2134 15.3209C36.4069 14.848 38.4406 13.7413 41.504 13.7413H49.9873C51.0881 13.7413 51.9845 14.1244 52.5137 14.8194Z" fill="#E6E6E6" />
                                                    <path d="M3.76591 4.15034C4.42637 3.38326 5.41558 2.95974 6.54991 2.95974H13.7271C16.6217 2.95974 18.5991 3.55208 19.071 3.88872C20.315 6.15147 25.8494 6.26796 26.9679 6.26796H38.0655C40.7734 6.26796 43.1438 7.64911 43.4538 8.88414L43.9296 10.7786H41.505C38.0388 10.7786 34.1392 12.0334 33.3909 14.4265C33.1964 14.8994 31.1627 16.0061 28.1003 16.0061H18.4738C14.5455 16.0061 10.6331 18.9688 9.56789 22.7509L7.79778 29.0405L3.00277 7.07849C2.83396 5.95797 3.10545 4.91742 3.76591 4.15034Z" fill="#E6E6E6" />
                                                </svg>
                                            </div>
                                            @* Mensaje para búsqueda manual sin resultados *@
                                            <p class="m-0 text-gray-700 font-semibold">
                                                No hay solicitudes que coincidan con tu búsqueda.
                                            </p>

                                            <p class="m-0 text-neutral-600">
                                                Prueba ajustando los criterios de búsqueda o limpiando los filtros.
                                            </p>

                                            <button type="button" class="boton-secundario m-0" @onclick="LimpiarFiltrosAsync">
                                                Limpiar filtros
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="h-16 w-16">
                                            @* Placeholder para ícono *@
                                                <svg width="60px" height="60px" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                                                  <path fill="var(--ci-primary-color, #007036)" d="M426.072,86.928A238.75,238.75,0,0,0,88.428,424.572,238.75,238.75,0,0,0,426.072,86.928ZM257.25,462.5c-114,0-206.75-92.748-206.75-206.75S143.248,49,257.25,49,464,141.748,464,255.75,371.252,462.5,257.25,462.5Z" class="ci-primary" />
                                                  <polygon fill="var(--ci-primary-color, #007036)" points="221.27 305.808 147.857 232.396 125.23 255.023 221.27 351.063 388.77 183.564 366.142 160.937 221.27 305.808" class="ci-primary" />
                                                </svg>
                                            </div>
                                            @* Mensaje para carga inicial sin resultados *@
                                            <p class="m-0 text-gray-700 font-semibold">
                                                Sin solicitudes @GetEstadoDisplayName((EnumEstadoFacturacionElectronica)FiltroEstado).ToLower() en este momento.
                                            </p>

                                            <p class="m-0 text-neutral-600">
                                                Las solicitudes aparecerán aquí cuando requieran revisión.
                                            </p>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="w-full overflow-x-auto">
                                    <QuickGrid ItemsProvider="@FacturacionProvider"
                                               @ref="Grid"
                                               Pagination="@Pagination"
                                               class="table">

                                        @* Inicio código generado por GitHub Copilot - Columna selección múltiple *@
                                        <TemplateColumn Title="">
                                            <HeaderTemplate Context="header">
                                                <input type="checkbox" @bind="SeleccionarTodos" class="ml-2" @bind:after="OnSeleccionarTodosChanged" />
                                            </HeaderTemplate>
                                            <ChildContent Context="c">
                                                <input type="checkbox" @bind="c.Seleccionado" />
                                            </ChildContent>
                                        </TemplateColumn>
                                        @* Fin código generado por GitHub Copilot - Columna selección múltiple *@

                                        @* 1. Columna Estado *@
                                        <TemplateColumn Title="Estado" Context="c" Align="Align.Left" Class="estado-column flex items-center gap-2">
                                            <span class="badge @GetEstadoBadgeClassPorPestana(c.Estado) whitespace-nowrap flex-shrink-0">
                                                @MapearEstadoAPestana(c.Estado)
                                            </span>
                                            @* 1. Detail button *@
                                            <div class="tooltip tooltip-secondary" data-tip="Ver detalles">
                                                <button class="btn btn-link m-0 h-fit p-0 text-base font-normal whitespace-nowrap"
                                                        type="button"
                                                        @onclick='async () => await ShowModal(c.IdPtesaPIN)'>
                                                            <svg width="25px" height="25px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                <path d="M15.0007 12C15.0007 13.6569 13.6576 15 12.0007 15C10.3439 15 9.00073 13.6569 9.00073 12C9.00073 10.3431 10.3439 9 12.0007 9C13.6576 9 15.0007 10.3431 15.0007 12Z" stroke="#acacac" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                                <path d="M12.0012 5C7.52354 5 3.73326 7.94288 2.45898 12C3.73324 16.0571 7.52354 19 12.0012 19C16.4788 19 20.2691 16.0571 21.5434 12C20.2691 7.94291 16.4788 5 12.0012 5Z" stroke="#acacac" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                            </svg>
                                                </button>
                                            </div>
                                        </TemplateColumn>

                                        @* 2. Columna Operador de recaudo *@
                                        <PropertyColumn Title="Operador de recaudo" Property="@(c => c.OperadorRecaudo)" Align="Align.Left" />

                                        @* 3. Columna Número de PIN *@
                                        <PropertyColumn Title="Número de PIN" Property="@(c => c.Pin)" Align="Align.Left" />

                                        @* 4. Columna Cliente pagador *@
                                        <TemplateColumn Title="Cliente pagador" Context="c" Align="Align.Left">
                                            <div>
                                                <div>@($"{c.Nombres} {c.Apellidos}")</div>
                                                <div class="text-sm text-gray-600">@c.Correo</div>
                                            </div>
                                        </TemplateColumn>

                                        @* 5. Columna Documento *@
                                    <TemplateColumn Title="Documento" Context="c" Align="Align.Left" Class="min-w-[180px] whitespace-nowrap">
                                            <span>@c.TipoDocumento @c.NumeroIdentificacion</span>
                                        </TemplateColumn>

                                        @* 6. Columna Valor total *@
                                        <TemplateColumn Title="Valor total" Context="c" Align="Align.Left">
                                            @(c.ValorTotal.ToString("C0", CultureInfo.GetCultureInfo("es-CO")))
                                        </TemplateColumn>

                                        @* 7. Columna Fecha de petición *@
                                        <TemplateColumn Title="Fecha de petición" Context="c" Align="Align.Left">
                                            <span class="tabular-nums whitespace-nowrap">
                                                @c.FechaRegistro.ToString("dd/MM/yyyy - h:mm:ss tt", CultureInfo.InvariantCulture).ToLowerInvariant()
                                            </span>
                                        </TemplateColumn>

                                        @* 8. Columna Fecha de facturación *@
                                        <TemplateColumn Title="Fecha de facturación" Context="c" Align="Align.Left">
                                            @{
                                                var fechaFormateada = c.FechaFacturacion.HasValue
                                                ? c.FechaFacturacion.Value.ToString("dd/MM/yyyy - h:mm:ss tt", CultureInfo.InvariantCulture).ToLowerInvariant()
                                                : "-";
                                            }
                                            <span class="tabular-nums whitespace-nowrap">@fechaFormateada</span>
                                        </TemplateColumn>

                                        @* 9. Columna Número de factura *@
                                        <TemplateColumn Title="Número de factura" Context="c" Align="Align.Left">
                                            @if (!string.IsNullOrWhiteSpace(c.urlPdfFactura))
                                            {
                                                <div class="tooltip tooltip-secondary" data-tip="Ver factura en estela">
                                                    <a href="@c.urlPdfFactura" rel="noopener noreferrer"
                                                       target="_blank" class="btn btn-link m-0 h-fit p-0 text-base font-normal whitespace-nowrap">
                                                        @c.NumeroFactura
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>@(c.NumeroFactura ?? "-")</span>
                                            }
                                        </TemplateColumn>

                                    </QuickGrid>
                                </div>
                            }

                            @* Paginador *@
                            <div class="sticky left-0 m-0 grid grid-cols-[1fr_auto_1fr] items-baseline gap-6 py-3">
                                @if (Pagination.TotalItemCount.HasValue)
                                {
                                    <div class="justify-self-start">
                                        <strong>@Pagination.TotalItemCount</strong>
                                        @(Pagination.TotalItemCount == 1 ? "solicitud encontrada" : "solicitudes encontradas")
                                    </div>

                                    <div class="justify-self-center">
                                        @if (Pagination.TotalItemCount > 1)
                                        {
                                            @* Inicio refactorización/optimización por GitHub Copilot *@
                                            @* type="button" en todos los botones del paginador evita que el EditForm *@
                                            @* los interprete como type="submit" (comportamiento por defecto en HTML)*@
                                            
                                            @if (Pagination.LastPageIndex > 9)
                                            {
                                                <div class="join">
                                                    <button type="button" @onclick="@(() => GoFirstAsync())"
                                                            class="btn join-item btn-sm text-neutral-700"
                                                            aria-label="Ir a la primera página"
                                                            disabled="@(!CanGoBack)">
                                                        <svg class="feather size-4">
                                                            <use xlink:href="assets/feather-sprite.svg#skip-back" />
                                                        </svg>
                                                    </button>
                                                    <button type="button" @onclick="@(() => GoPreviousAsync())"
                                                            class="btn join-item btn-sm text-neutral-700"
                                                            aria-label="Ir a la página anterior"
                                                            disabled="@(!CanGoBack)">
                                                        <svg class="feather size-4">
                                                            <use xlink:href="assets/feather-sprite.svg#chevron-left" />
                                                        </svg>
                                                    </button>
                                                    <button type="button" class="btn join-item btn-sm pointer-events-none text-neutral-800">
                                                        Página @(Pagination.CurrentPageIndex + 1) de @(Pagination.LastPageIndex + 1)
                                                    </button>
                                                    <button type="button" @onclick="@(() => GoNextAsync())"
                                                            class="btn join-item btn-sm text-neutral-700"
                                                            aria-label="Ir a la página siguiente"
                                                            disabled="@(!CanGoForwards)">
                                                        <svg class="feather size-4">
                                                            <use xlink:href="assets/feather-sprite.svg#chevron-right" />
                                                        </svg>
                                                    </button>
                                                    <button type="button" @onclick="@(() => GoLastAsync())"
                                                            class="btn join-item btn-sm text-neutral-700"
                                                            aria-label="Ir a la última página"
                                                            disabled="@(!CanGoForwards)">
                                                        <svg class="feather size-4">
                                                            <use xlink:href="assets/feather-sprite.svg#skip-forward" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="join">
                                                    @for (var pageIndex = 0; pageIndex <= Pagination.LastPageIndex; pageIndex++)
                                                    {
                                                        var capturedIndex = pageIndex;
                                                        <button type="button" @onclick="@(() => GoToPageAsync(capturedIndex))"
                                                                class="join-item btn @PageButtonClass(capturedIndex)"
                                                                aria-current="@AriaCurrentValue(capturedIndex)"
                                                                aria-label="Ir a página @(pageIndex + 1)">
                                                            @(pageIndex + 1)
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            @* Fin refactorización/optimización por GitHub Copilot *@
                                        }
                                    </div>

                                    <div class="flex flex-row items-baseline gap-2 justify-self-end">
                                        <label for="items" class="font-medium whitespace-nowrap">ítems por página</label>
                                        <select id="items" @bind="@Pagination.ItemsPerPage" class="w-max">
                                            <option>10</option>
                                            <option>15</option>
                                            <option>20</option>
                                            <option>25</option>
                                        </select>
                                    </div>
                                }
                            </div>
                        </figure>
                    </div>
                </EditForm>
        }
        
    </ContentTemplate>
</SpinLoader>

<ModalDetalleFacturacion @ref="ModalDetalleFacturacionRef"></ModalDetalleFacturacion>

@* Fin código generado por GitHub Copilot *@

