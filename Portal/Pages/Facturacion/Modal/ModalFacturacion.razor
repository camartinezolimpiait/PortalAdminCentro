@* ModalFacturacion.razor - SIN @page *@
@* Inicio código generado por GitHub Copilot *@

@if (MostrarModal == 1)
{
    <div class="modal modal-open">
        <div class="modal-box max-w-sm text-center">
            @* Botón X para cerrar *@
            <button class="btn btn-sm btn-circle absolute right-2 top-2" @onclick="Cerrar">✕</button>
            <div class="flex justify-center mb-4">
                <div class="bg-warning/20 rounded-full p-4 w-20 h-20 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
            </div>

            <h3 class="font-bold text-lg mb-4">@(Total > 1 ? "Anular solicitudes" : "Anular solicitud")</h3>
            <p class="text-base mb-6">¿Confirmas que deseas anular @(Total > 1 ? "las solicitudes" : "la solicitud") de factura?</p>

            <div class="modal-action justify-center gap-3">
                <button class="btn btn-outline" @onclick="Cancelar">Cancelar</button>
                <button class="btn btn-primary" @onclick="Aceptar">Aceptar</button>
            </div>
        </div>
    </div>

}

@if (MostrarModal == 2)
{
    <div class="modal modal-open">
        <div class="modal-box max-w-sm text-center">
            @* Botón X para cerrar *@
            <button class="btn btn-sm btn-circle absolute right-2 top-2" @onclick="Cerrar">✕</button>

            @* Icono de éxito (checkmark verde) *@
            <div class="flex justify-center mb-4">
                <div class="bg-success/20 rounded-full p-4 w-20 h-20 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
            </div>

            @* Título *@
            <h3 class="font-bold text-lg mb-4">@(Total > 1 ? "Anular solicitudes" : "Anular solicitud")</h3>

            @* Mensaje de confirmación *@
            <p class="text-base mb-6">@(Total > 1 ? "Solicitudes anuladas" : "Solicitud anulada") exitosamente</p>

            @* Botón de acción *@
            <div class="modal-action justify-center">
                <button class="btn btn-primary px-8" @onclick="AceptarAnulacion">Aceptar</button>
            </div>
        </div>
    </div>
}

@if (MostrarModal == 3)
{
    <div class="modal modal-open">
        <div class="modal-box max-w-md text-center">
            @* Botón X para cerrar *@
            <button class="btn btn-sm btn-circle absolute right-2 top-2" @onclick="Cerrar">✕</button>

            @* Icono de error (X roja) *@
            <div class="flex justify-center mb-4">
                <div class="bg-error/20 rounded-full p-4 w-20 h-20 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </div>
            </div>

            @* Título *@
            <h3 class="font-bold text-lg mb-4">Error al anular</h3>

            @* Mensaje de error *@
            <p class="text-base mb-2">Ocurrió un error al intentar anular las solicitudes.</p>
            <p class="text-base mb-4">Por favor, inténtalo nuevamente.</p>

            @* Mensaje de contacto *@
            <p class="text-sm text-gray-600 mb-6">
                Si el error persiste, contáctanos en:
                <a href="mailto:soporte@olimpiait.com" class="text-blue-600 hover:underline">soporte@olimpiait.com</a>
            </p>

            @* Botón de acción *@
            <div class="modal-action justify-center">
                <button class="btn btn-primary px-8" @onclick="Cerrar">Cerrar</button>
            </div>
        </div>
    </div>
}

