@page "/ChangePassword"
@inject HttpClient Http
@using Microsoft.Extensions.Configuration
@using portalAdministrativoSISEC.Application.Data
@using portalAdministrativoSISEC.Util.Helpers
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<h3>Restablecer Contraseña</h3>
<p>Diligencia los siguientes campos para reestablecer tú contraseña.</p>

<div class="formulario">

    <div class="formulario-marco">
        <EditForm Model="@dataUser" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />

            <label for='usuario'>Contraseña temporal</label>
            <input type='password' id='usuario' name='usuario' @bind-value="@dataUser.oldPassWord" required>
            <label for='password'>Nueva contraseña</label>
            <input type='password' id='password' name='password' @bind-value="@dataUser.passWord" required>
            <label for='password'>Confirmar contraseña</label>
            <input type='password' id='password' name='password' @bind-value="@repeatPassword" required>
            <input class="boton-primario" type='submit' value='Actualizar contraseña'>

            @if (!string.IsNullOrEmpty(mnsValidatePass.ToString().Replace("<ul></ul>", ""))) { 
            <div class="alert alert-info alert-warning fade show" role="alert">
                <span class="">@((MarkupString)mnsValidatePass)</span>
            </div>
            }

            <AlertMessage message="@message" typeAlert="@typeAlert"></AlertMessage>
        </EditForm>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show" id="myModal" style="display:block" aria-modal="true" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">

                <!-- Modal body -->
                <div class="modal-body">
                    <h4>Su contraseña se a actualizado exitosamente</h4>
                    <p>Inicie sesión con los nuevos datos</p>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer text-center">
                    @*<button type="button" class="btn" @onclick="@(() => showModal = !showModal)">Cancelar</button>*@
                    <button type="button" class="btn btn-primary" @onclick=@(() => Navigation.NavigateTo("/",false))>Entendido</button>
                </div>

            </div>
        </div>
    </div>
}



@code {

    portalAdministrativoSISEC.Application.Data.ChangePassword dataUser = new portalAdministrativoSISEC.Application.Data.ChangePassword();
    private string apiName = null;
    private string emailRecoverPass { get; set; }
    private string message = null;
    private string typeAlert = null;
    private string repeatPassword = "";
    string google { get; set; }
    private string alerttextclass { get; set; }
    [Parameter] public string token { get; set; }
    [Inject] private IApiService _apiService { get; set; }
    bool showModal = false;
    MarkupString mnsValidatePass;
    private ApplicationSevice menuService = new ApplicationSevice();

    protected async Task OnValidSubmit()
    {
        mnsValidatePass = new MarkupString("");
        message = "";
        typeAlert = "";

        if (dataUser.passWord != repeatPassword)
        {
            message = "Las contraseñas no coinciden";
            typeAlert = "danger";
            return;
        }

        SecurityPolitics securityPolitics = new SecurityPolitics();
        mnsValidatePass = new MarkupString(securityPolitics.ValidatorPassword(dataUser.passWord));

        if (string.IsNullOrEmpty(mnsValidatePass.ToString().Replace("<ul></ul>", "")))
            await OnChangePassword();
    }

    protected async Task OnChangePassword()
    {
        dataUser.plataforma = menuService.Plataforma;
        dataUser.userName = menuService.UserName;

        try
        {
            var response = await _apiService.CallApiAsync<ResetPasswordResponse>(
                baseAddress: @Configuration["AppSettings:uriSisecAuth"],
                apiEndpoint: "AspNetUser/CambioContrasena",
                method: HttpMethod.Post,
                content: dataUser,
                apiKey: "SisecAut"
            );

            if (response.IsSuccess)
            {
                ResetPasswordResponse resetPasswordResponse = response.Content;

                if (resetPasswordResponse.Respuesta)
                {
                    menuService.MustChangePassword = false;
                    message = resetPasswordResponse.RespuestaTexto;
                    typeAlert = "success";
                }
                else
                {
                    message = resetPasswordResponse.RespuestaTexto;
                    typeAlert = "danger";
                }
            }
            else
            {
                message = response.HttpResponse.ReasonPhrase;
                typeAlert = "danger";
            }
        }
        catch (Exception ex)
        {
            message = $"Error cambiando contraseña: {ex.Message}";
            typeAlert = "danger";
        }
    }

}
