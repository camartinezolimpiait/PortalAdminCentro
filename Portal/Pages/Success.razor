@page "/Success"
@layout SingleLayout
@inject NavigationManager UriHelper

<div class="formulario-2">
    <div class="row">
        <div class="col-2">
            <svg style="height: 136px">
                <use xlink:href="assets/iconos.svg#icono-ok" />
            </svg>
        </div>
        <div class="col-10">
            <h1 class="mensajeSuccess">Enrolamiento exitoso</h1>
            <p>{NombreAspirante} ya puede empezar a agendar clases teóricas.</p>
            <button type="button" class="boton-secundario" @onclick="@Siguiente">Volver al inicio</button>
        </div>
    </div> 
</div>

@code {
    void Siguiente ()
    {
        UriHelper.NavigateTo ("Reject");
    }
}
