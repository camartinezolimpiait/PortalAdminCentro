@page "/compradepin/proceedtopayment"
@inherits LayoutComponentBase
@using portalAdministrativoSISEC.Data.CompraPin;
@using portalAdministrativoSISEC.Pages.Common
@using portalAdministrativoSISEC.Pages.CompraPin
@using portalAdministrativoSISEC.Pages.CompraPin.Categorias
@using portalAdministrativoSISEC.Pages.CompraPin.Common
@using portalAdministrativoSISEC.Pages.CompraPin.DatosBasicos
@using portalAdministrativoSISEC.Pages.CompraPin.DatosPersonales
@using portalAdministrativoSISEC.Pages.CompraPin.Tramite
@using portalAdministrativoSISEC.Pages.CompraPin.Resumen;
@using portalAdministrativoSISEC.Pages.CompraPin.Blog;
@using portalAdministrativoSISEC.Pages.CompraPin.ResumenCompra;
@inject NavigationManager NavManager


<SpinLoader IsLoading="isLoading">
    <LoadingTemplate>
        <div style="height:100%;display:flex">
            <br />
            <Circle Center="true" Color="var(--azul-600)"></Circle>
        </div>
    </LoadingTemplate>
    <ContentTemplate>
        <div class="wrapper">
            <div class="max-w-[570px]">
                <h3>Prepara tu pago</h3>
                <p>Antes de continuar, sigue estos pasos para completar tu compra de PIN:</p>
                <h4>1. Copia tu NUT (número de autorización):</h4>
                <p>Este número se solicitará en el siguiente paso, en la plataforma de pagos.</p>

                <div class="flex items-center justify-between border border-azul-700 rounded-lg px-4 py-2 w-full  bg-white">
                    <div class="flex items-center space-x-2">
                        <span class="text-gray-700">NUT (Número de autorización):</span>
                        <span class="text-azul-700 font-semibold">@nut</span>
                    </div>

                    <button class="@($"flex items-center text-white text-sm font-medium px-3 py-1.5 rounded-md transition-colors duration-150 cursor-pointer {(mensajeCopiado is not null ? "bg-green-600 hover:bg-green-700" : "bg-azul-700 hover:bg-azul-800")}")"
                            @onclick="CopiarNUT">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2M8 16h8a2 2 0 002-2V8a2 2 0 00-2-2H8m0 10v2a2 2 0 002 2h8a2 2 0 002-2v-2" />
                        </svg>
                        @(mensajeCopiado is not null ? "Copiado" : "Copiar")
                    </button>

                </div>
                <h4>2. Haz clic en “Ir a la pasarela de pago”</h4>
                <p>Serás redirigido(a) de forma segura para finalizar tu pago, No cierres esta ventana hasta completar el proceso de pago.</p>

                <div class="flex justify-end items-center w-full bg-white">
                    <button class="@($"text-sm font-medium px-4 py-1.5 rounded-md transition-colors duration-150 {(mensajeCopiado is not null ? "bg-azul-700 hover:bg-azul-500 text-white cursor-pointer" : "bg-gray-200 text-gray-400 cursor-not-allowed")}")"
                            @onclick="IrPasarelaPago"
                            disabled="@(mensajeCopiado is null)">
                        Ir a la pasarela de pago
                    </button>
                </div>
            </div>

        </div>

        <ModalPseColpatria @bind-Open="abrirModal"></ModalPseColpatria>
    </ContentTemplate>
</SpinLoader>

