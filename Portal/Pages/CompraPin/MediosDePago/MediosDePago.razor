@page "/compradepin/mediosdepago"
@inherits LayoutComponentBase
@using portalAdministrativoSISEC.Application.Data.CompraPin;
@using portalAdministrativoSISEC.Enum.PortalAdministrativo
@using portalAdministrativoSISEC.Pages.CompraPin
@using portalAdministrativoSISEC.Pages.CompraPin.CouponCode
@inject NavigationManager NavManager

<SpinLoader IsLoading="isLoading">
    <LoadingTemplate>
        <div style="height:100%;display:flex">
            <br />
            <Circle Center="true" Color="var(--azul-600)"></Circle>
        </div>
    </LoadingTemplate>
    <ContentTemplate>
        <div class="w-[90%]">
            <h3>
                Selecciona el medio de pago
            </h3>

            <p>
                Verifica que tu información este correcta. Enviaremos la confirmación de la compra al correo electrónico
                registrado. Además los datos serán usados por el usuario para gestionar su PIN
            </p>

            <h4>Medios de pago disponibles</h4>

            <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                @if (pagoPin.MediosPago != null && pagoPin.MediosPago.Any())
                {
                    <fieldset class="w-auto max-w-none overflow-clip rounded-lg border border-neutral-300 p-0">
                        <InputRadioGroup @bind-Value="MediosDePagoModel.TipoRecaudoCtrl" name="mediopago" @bind-Value:after="() => ChangeMethod()">
                            @foreach (var medio in pagoPin.MediosPago)
                            {
                                <div class="relative flex w-full items-center justify-between border-t border-t-neutral-300 bg-neutral-200 p-3 first:border-t-0 has-checked:border-b-2 has-checked:border-b-azul-400 has-checked:bg-neutral-50">
                                    <label class="flex cursor-pointer items-center gap-1 font-medium text-neutral-700 after:absolute after:top-0 after:right-0 after:bottom-0 after:left-0">
                                        <InputRadio Value="medio.Id"/>
                                        <span class="truncate">@medio.Nombre</span>
                                    </label>
                                    @if (!string.IsNullOrEmpty(medio.IconoUrl))
                                    {
                                        <img src="@medio.IconoUrl" alt="logotipo de @medio.Nombre" class="h-8 shrink-0" />
                                    }
                                </div>
                            }
                        </InputRadioGroup>
                    </fieldset>
                }
                else
                {
                    <p>No tiene medios de pago disponibles.</p>
                }

                <ValidationMessage For="@(() => MediosDePagoModel.TipoRecaudoCtrl)" />

   @* Inicio código generado por GitHub Copilot *@
     @* Componente de Código de Cupón/Referido - Solo se muestra si hay medios de pago disponibles *@
         @if (pagoPin.MediosPago != null && pagoPin.MediosPago.Any())
    {
        <CouponCode PagoPin="pagoPin" 
            CouponAplicadoEvent="@OnCouponAplicado" />
           }
                @* Fin código generado por GitHub Copilot *@

                <div class="mt-3 mb-4 flex w-[95%] items-center gap-2 rounded-md border border-blue-200 bg-blue-50 p-3">
                    <!-- Icono -->
                    <svg class="feather mr-1 flex-shrink-0 text-blue-600">
                        <use xlink:href="assets/feather-sprite.svg#info"></use>
                    </svg>

                    <!-- Texto -->
                    <p class="m-0 text-base text-gray-600">
                        Recuerda que el dinero se reflejará en la cuenta registrada según el medio de pago que elijas.
                    </p>
                </div>



                <div class="mt-5 flex items-center space-x-3">
                    <button type="button" class="boton-secundario mr-2" @onclick="Retroceder">
                        Atrás
                    </button>
                    <button type="submit" class="boton-primario"> Siguiente </button>
                </div>
            </EditForm>
        </div>

    </ContentTemplate>

</SpinLoader>

