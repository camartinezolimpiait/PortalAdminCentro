@page "/Photo"
@inject IJSRuntime jsRuntime
@layout SingleLayout
@inject NavigationManager UriHelper
@using Microsoft.Extensions.Configuration
@using System.IO;
@using Microsoft.AspNetCore.Mvc;
@inject IConfiguration Configuration
@inject HttpClient Http
<link href="~/css/Tramite/pasos.css" rel="stylesheet" />
<div class="col-12 paso-captura-foto">
    <h3>Fotografía</h3>
    <div class="captura-foto-container">
        <video muted="muted" id="video" width="400" height="350" hidden="@(!Capturando)">
        </video>
        <img width="400" height="350" src="@Foto" hidden="@Capturando" />
        <div class="btn-captura-container">
            <div hidden="@(!Capturando)">
                <button class="boton-primario" id="cambiarcamra" hidden="@(!Capturando)"
                        @onclick="cambiar">
                    Cambiar cámara
                </button>
            </div>
            <button class="boton-primario" id="botonIniciarCaptura" @onclick="Capturar">
                @TextoBoton
            </button>
            <button type="button" class="boton-primario" @onclick="@Siguiente">Usar esta imagen</button>
        </div>
    </div>
</div>

