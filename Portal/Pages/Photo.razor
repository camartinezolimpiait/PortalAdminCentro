@code {

    private string apiName = null;
    bool showModal = true;
    bool showModalValida = false;
    private string message = null;
    private string typeAlert = null;
    private ApplicationSevice menuservice = new ApplicationSevice();

    void Siguiente()
    {
        string[] img = Foto.Split(",");
        registrarostro(img[1]);
        UriHelper.NavigateTo("Finger");
    }

    [Inject]
    public IJSRuntime JsRuntime { get; set; }
    private string TextoBoton { get => Capturando ? "Tomar foto" : "Iniciar nueva captura"; }
    private bool Capturando { get; set; } = false;
    [Parameter]
    public string Foto { get; set; }

    [Parameter]
    public EventCallback<string> FotoChanged { get; set; }

    [Parameter]
    public EventCallback<bool> ReadyChanged { get; set; }
    private async Task Capturar()
    {
        if (!Capturando)
        {
            Capturando = await JsRuntime.InvokeAsync<bool>("IniciarCaptura");
            await ReadyChanged.InvokeAsync(false);
        }
        else
        {
            Foto = await JsRuntime.InvokeAsync<string>("TerminarCaptura");
            await FotoChanged.InvokeAsync(Foto);
            await ReadyChanged.InvokeAsync(true);
            Capturando = false;
        }
        StateHasChanged();
    }

    private async Task cambiar()
    {
        await JsRuntime.InvokeAsync<string>("cambiarcamra");
        //await ReadyChanged.InvokeAsync(true);
    }


    private async void registrarostro(string base64ImageRepresentation)
    {
        EntradaRegistroRostro entradaRegistroRostro = new EntradaRegistroRostro();
        entradaRegistroRostro.Numerodocumento = menuservice.entradaEnrolamiento.NumeroDocumento;
        entradaRegistroRostro.idTipoDocumento = Convert.ToInt32(menuservice.entradaEnrolamiento.TipoDocumentoId);
        entradaRegistroRostro.idCliente = menuservice.ClienteId;
        entradaRegistroRostro.IdAfis = menuservice.TipoAfisId;
        entradaRegistroRostro.ImagenRostroBase64 = base64ImageRepresentation;

        Http = new HttpClient();
        apiName = "RegistraRostroSISEC";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);


        var stringContent = new StringContent(JsonConvert.SerializeObject(entradaRegistroRostro), System.Text.Encoding.UTF8, "application/json");
        var response = await Http.PostAsync(apiName, stringContent);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            RespGeneralModel RespGeneralModel = JsonConvert.DeserializeObject<RespGeneralModel>(content);
        }
        else
        {
            message = response.ReasonPhrase;
            typeAlert = "danger";
        }

    }
}
