                                    }
                                </InputSelect>
                            </EditForm>
                        </td>
                    </tr>
                </table>
                <button type="button" class="boton-primario" @onclick="@Siguiente">Siguiente</button>
            </div>
        </div>
    </div>
</div>

@code {

    List<EstadoCivilDTO> ListaEstadoCivil = new List<EstadoCivilDTO>();
    List<EpsDTO> ListaEps = new List<EpsDTO>();
    List<GradoEscolaridadDTO> ListaGradoEscolaridad = new List<GradoEscolaridadDTO>();
    List<GrupoSanguineoDTO> ListaGrupoSanguineo = new List<GrupoSanguineoDTO>();
    List<OcupacionDTO> ListaOcupacion = new List<OcupacionDTO>();
    List<RegimenAfiliacionDTO> ListaRegimeAfiliacion = new List<RegimenAfiliacionDTO>();
    private ApplicationSevice menuservice = new ApplicationSevice();
    [Inject]
    public IApiService _apiService { get; set; }

    private string apiName = null;
    private string message = null;
    private string typeAlert = null;

    protected override async Task OnInitializedAsync()
    {
        ListaEstadoCivil = await ObtenerEstadoCivil();
        ListaEps = await ObtenerEps();
        ListaGradoEscolaridad = await ObtenerGradoEscolaridad();
        ListaGrupoSanguineo = await ObtenerGrupoSanguineo();
        ListaOcupacion = await ObtenerOcupacion();
        ListaRegimeAfiliacion = await ObtenerRegimenAfiliacion();
    }
    private async void Siguiente()
    {
        menuservice.entradaEnrolamiento.Sincronizar = true;
        menuservice.entradaEnrolamiento.procesoNuevo = false;

        Http = new HttpClient();
        apiName = "RegistrarPersonaProceso";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);


        var stringContent = new StringContent(JsonConvert.SerializeObject(menuservice.entradaEnrolamiento), System.Text.Encoding.UTF8, "application/json");
        var response = await Http.PostAsync(apiName, stringContent);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            menuservice.respuestaEnrolarPersona = JsonConvert.DeserializeObject<RespuestaEnrolarPersona>(content);
            if (menuservice.respuestaEnrolarPersona.codigoError != "0")
            {
                message = menuservice.respuestaEnrolarPersona.DescripcionError;
                typeAlert = "success";
            }
            else
            {
                if (menuservice.ClienteId == 1)
                {
                    UriHelper.NavigateTo("ValPinCRC");
                }
                else
                {

                    UriHelper.NavigateTo("ValPinCEA");
                }
            }
        }
        else
        {
            message = response.ReasonPhrase;
            typeAlert = "danger";
        }
        //showLoader = false;
        //UriHelper.NavigateTo("AuthData");

    }

    protected async Task<List<EstadoCivilDTO>> ObtenerEstadoCivil()
    {
        List<EstadoCivilDTO> estadoCivilDTO = new List<EstadoCivilDTO>();

        ApiResponse<List<EstadoCivilDTO>> response = await _apiService.CallApiAsync<List<EstadoCivilDTO>>(
            baseAddress: @Configuration["AppSettings:uriSisecParametization"],
            apiEndpoint: "EstadoCivil/ObtenerEstadoCivilTodosAsync",
            method: HttpMethod.Get,
            content: null
        );

        if (response != null && response.HttpResponse != null && response.HttpResponse.IsSuccessStatusCode)
        {
            estadoCivilDTO = response.Content
                .OrderBy(x => x.Nombre)
                .ToList();
        }

        return estadoCivilDTO;
    }


