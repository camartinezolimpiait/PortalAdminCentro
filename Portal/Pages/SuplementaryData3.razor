                            <label for='GrupoSanguineo'>Grupo Sanguineo</label>
                            <EditForm Model="@menuservice.entradaEnrolamiento">
                                <InputSelect name="GrupoSanguineo"
                                             id="GrupoSanguineo"
                                             class="form-group"
                                             @bind-Value="@menuservice.entradaEnrolamiento.GrupoSanguinioId">
