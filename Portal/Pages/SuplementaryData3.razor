                                    <option value="" selected>Seleccione...</option>
                                    @foreach (var itemOcupacion in ListaOcupacion)
                                    {
                                        <option value="@itemOcupacion.Id">@itemOcupacion.Nombre</option>
                                    }
                                </InputSelect>
                            </EditForm>
                        </td>
                        <td style="width:550px">
                            <label for='RegimeAfiliacion'>Régimen Afiliación</label>
                            <EditForm Model="@menuservice.entradaEnrolamiento">
                                <InputSelect name="RegimeAfiliacion"
