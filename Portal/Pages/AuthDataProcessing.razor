@page "/AuthData"
@layout SingleLayout
@inject NavigationManager UriHelper
@using Microsoft.Extensions.Configuration
@using System.IO;
@using Microsoft.AspNetCore.Mvc;
@inject IConfiguration Configuration
@inject HttpClient Http


<div class="formulario-2 ">
    <h2>Firma y autorización de tratamiento de datos personales</h2>

    <div class="row">
        <div class="col-6">
            <embed class="tamanio-pdf" type="application/pdf" src="data:application/pdf;base64,@pdfFile" />
        </div>
        <div class="col-6">
            <div class="rectangulo">
                <img alt="" src="@pathImagenFirma2" style="height:auto;width:auto;" />
            </div>
            <br />

            <div>
                <label> @menuservice.entradaEnrolamiento.NumeroDocumento </label>
                <br />
                <label> @menuservice.entradaEnrolamiento.NombreCompleto</label>
            </div>
            <br />
            <button type="button" class="boton-primario" @onclick="@CapturarFirma">Capturar Firma</button>
            <button type="button" class="boton-primario" @onclick="@Siguiente">Siguiente</button>
        </div>
    </div>
</div>

@code {
    EntradaEnrolamiento entradaEnrolamiento = new EntradaEnrolamiento();
    private string apiName = null;
    private string message = null;
    private string typeAlert = null;
    string imageFirmaBase64 = string.Empty;
    string pathImagenFirma = string.Empty;
    string pathImagenFirma2 = string.Empty;
    string[] strIdHuella;
    private ApplicationSevice menuservice = new ApplicationSevice();

    ///string pdfFile = "";
    string pdfFile = string.Empty;
    protected async override void OnInitialized()
    {
        InicializaTabla();
        pdfFile = await obtenerPdf();
        pathImagenFirma = "wwwroot/img/" + menuservice.entradaEnrolamiento.NumeroDocumento.ToString() + "firma.jpg";
        pathImagenFirma2 = "img/" + menuservice.entradaEnrolamiento.NumeroDocumento.ToString() + "firma.jpg";
        StateHasChanged();
    }


    async void Siguiente()
    {
        EntradaRegistroFirma entradaRegistroFirma = new EntradaRegistroFirma();
        RespGeneralModel respGeneralModel = new RespGeneralModel();
        entradaRegistroFirma.Numerodocumento = menuservice.entradaEnrolamiento.NumeroDocumento;
        entradaRegistroFirma.idTipoDocumento = Convert.ToInt32(menuservice.entradaEnrolamiento.TipoDocumentoId);
        entradaRegistroFirma.idCliente = (int)menuservice.entradaEnrolamiento.ClienteId;
        entradaRegistroFirma.IdAfis = menuservice.entradaEnrolamiento.TipoAfisId;
        entradaRegistroFirma.keyFirma = menuservice.keyFirma;

        Http = new HttpClient();
        apiName = "RegistraFirmaSISEC";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);


        var stringContent = new StringContent(JsonConvert.SerializeObject(entradaRegistroFirma), System.Text.Encoding.UTF8, "application/json");
        var response = await Http.PostAsync(apiName, stringContent);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            respGeneralModel = JsonConvert.DeserializeObject<RespGeneralModel>(content);
        }
        //if (respGeneralModel.Respuesta)
        //{
        //    UriHelper.NavigateTo("AuthData");
        //}

        if (File.Exists(pathImagenFirma))
        {
            File.Delete(pathImagenFirma);
        }
        firmaPdf();

        UriHelper.NavigateTo("Photo");
    }

    async void InicializaTabla()
    {

        Http = new HttpClient();
        var apiName = "/wacomsign";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);

        var response = await Http.GetAsync(apiName);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            JsonConvert.DeserializeObject<string>(content);
        }

    }

    async void CapturarFirma()
    {
        Http = new HttpClient();
        var apiName = "/CapturarImgenFirma";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);

        var response = await Http.GetAsync(apiName);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            strIdHuella = content.Split("|");
            await ObtenerImagenFirma(strIdHuella[1]);
        }
    }

    private async Task<string> ObtenerImagenFirma(string id)
    {
        string keyImagen = string.Empty;
        Http = new HttpClient();
        var apiNameGetImagen = "/GetFingerprintReaderImage/" + id.Trim();
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);
        var responseImage = await Http.GetAsync(apiNameGetImagen);

        if (responseImage.IsSuccessStatusCode)
        {
            var contentImage = await responseImage.Content.ReadAsStringAsync();
            if (contentImage.Length > 10)
            {
                contentImage = contentImage.Replace(@"\", "");
                contentImage = contentImage.Substring(1, contentImage.Length - 2);
                byte[] imageBytes = Convert.FromBase64String(contentImage);
                // Convert byte[] to Image
                using (var ms = new MemoryStream(imageBytes, 0, imageBytes.Length))
                {
                    string b64img = Convert.ToBase64String(imageBytes);
                    imageFirmaBase64 = b64img;
                }

                using (var imageFile = new FileStream(pathImagenFirma, FileMode.Create))
                {
                    imageFile.Write(imageBytes, 0, imageBytes.Length);
                    imageFile.Flush();
                }
                menuservice.keyFirma = id;
                menuservice.base64Firma = imageFirmaBase64;
                UriHelper.NavigateTo("AuthData", forceLoad: true);
            }


        }
        return keyImagen;
    }

    async Task<string> obtenerPdf()
    {
        string pdfBase = string.Empty;
        ConsultaFormatosxTipoDocumentoId consultaFormatosxTipoDocumento = new ConsultaFormatosxTipoDocumentoId();
        consultaFormatosxTipoDocumento.clienteId = (int)menuservice.entradaEnrolamiento.ClienteId;
        consultaFormatosxTipoDocumento.TipodocumentoId = Convert.ToInt32(menuservice.entradaEnrolamiento.TipoDocumentoId);
        Http = new HttpClient();
        var apiName = "/ObtenerPdfTratamientoDatos";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);


        var stringContent = new StringContent(JsonConvert.SerializeObject(consultaFormatosxTipoDocumento), System.Text.Encoding.UTF8, "application/json");
        var response = await Http.PostAsync(apiName, stringContent);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            pdfFile = content;
            pdfFile = pdfFile.Replace(@"\", "");
            pdfFile = pdfFile.Substring(1, pdfFile.Length - 2);

        }
        menuservice.entradaEnrolamiento.DocumentoValidacion = pdfFile;
        menuservice.entradaEnrolamiento.byteDocumentoValidacion = Convert.FromBase64String(pdfFile);
        return pdfFile;
    }

    async void firmaPdf()
    {

        EntradaSolicitudfirmaDigital entradaSolicitudfirmaDigital = new EntradaSolicitudfirmaDigital();

        entradaSolicitudfirmaDigital.NombreArchivo = "PruebaArchivo.pdf";
        entradaSolicitudfirmaDigital.Archivo = menuservice.entradaEnrolamiento.DocumentoValidacion;
        entradaSolicitudfirmaDigital.Estampado = true;
        entradaSolicitudfirmaDigital.TipoRespuesta = 1;
        entradaSolicitudfirmaDigital.Imagen = menuservice.base64Firma;
        entradaSolicitudfirmaDigital.ImagenVisible = true;
        entradaSolicitudfirmaDigital.PuntoX = 10;
        entradaSolicitudfirmaDigital.PuntoY = 5;


        Http = new HttpClient();
        var apiName = "/firmaDigitalPdf";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);


        var stringContent = new StringContent(JsonConvert.SerializeObject(entradaSolicitudfirmaDigital), System.Text.Encoding.UTF8, "application/json");
        var response = await Http.PostAsync(apiName, stringContent);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            RespuestaFirmaDigital respuestaProceso = JsonConvert.DeserializeObject<RespuestaFirmaDigital>(content);
            File.WriteAllBytes(@"d:\alex\" + respuestaProceso.NombreArchivo, Convert.FromBase64String(respuestaProceso.Archivo));
            menuservice.entradaEnrolamiento.Base64DocumentoFirmadoFD = respuestaProceso.Archivo;
            menuservice.entradaEnrolamiento.ByteDocumentoFirmadoFD = Convert.FromBase64String(respuestaProceso.Archivo);
        }


    }


}
