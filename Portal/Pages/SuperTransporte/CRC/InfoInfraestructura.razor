@page "/supertransporte/centro/infraestructura"
@using portalAdministrativoSISEC.Entidades.SuperTransporte.CRC;
@layout FormularioLayout

<h3>Información de la infraestructura</h3>

<details class="detalles">
    <summary>Ver normatividad</summary>
    <div class="contenido">
        <h4>Resolución No 1135 de 2020 Título II, Capítulo III</h4>
        <p>
            7. Acreditar el cumplimiento de las condiciones de infraestructura exigidos en la Resolución 3100 de 2019 del Ministerio de Salud y Protección Social, o
            de la norma que la modifique, adicione o sustituya.
        </p>
    </div>
</details>

<EditForm Model="@_infoInfraestructuraDto" OnValidSubmit="@GuardarInformacion">
    <DataAnnotationsValidator />

    <fieldset class="ancho">
        <legend>Oficina administrativa</legend>
        <div class="explicacion">¿El establecimiento de comercio cuenta con espacio de oficina administrativa?</div>
        <ValidationMessage For="() => _infoInfraestructuraDto.oficina_admin" />
        <ValidationMessage For="() => _infoInfraestructuraDto.ubicacion_oficina" />
        <div class="flex_oficinas">
            <div >
                <InputCheckbox id="oficina_admin" @bind-Value="_infoInfraestructuraDto.oficina_admin" @oninput="(ChangeEventArgs e) => ActivarSeleccion(e, 1)" />
                <label for="oficina_admin">Sí cuenta</label>
            </div>
            @if (_infoInfraestructuraDto.oficina_admin)
            {
                <div >
                    <div class="validation-message">@error_ubicacion_oficina</div>
                    <label for="ubicacion_oficina">Ubicación</label>
                    <InputSelect id="ubicacion_oficina" @bind-Value="_infoInfraestructuraDto.ubicacion_oficina" @oninput="(ChangeEventArgs e) => CambioSeleccion(e, 1)">
                        <option value="">-</option>
                        @foreach (var item in _selectUbicaciones)
                        {
                            <option value="@item.id">@item.nombre</option>
                        }
                    </InputSelect>
                </div>
            }
        </div>
    </fieldset>

    <fieldset class="ancho">
        <legend>Servicios de aseo</legend>
        <div class="explicacion">¿El establecimiento de comercio cuenta con espacios de servicios de aseo?</div>
