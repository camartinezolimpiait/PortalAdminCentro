    <h4>Consultorios de optometría</h4>
    <EditForm Context="ConsultorioContext" Model="@_consultorios_opto" OnValidSubmit="@((EditContext context) => addConsultorio(context, _consultorios_opto, 1))">
        <DataAnnotationsValidator />

        <table class="tabla-responsive">
            <thead>
                <tr>
                    <th>Ubicación</th>
                    <th class="num">Largo (m)</th>
                    <th class="num">Ancho (m)</th>
                    <th class="num">Area (m²)</th>
                    <th class="num">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (_listConsultorios_opto != null)
                {@foreach (var consultorio in _listConsultorios_opto)
                    {
                        <tr>
                            <td>@_selectUbicaciones.Find(f => f.id == consultorio.ubicacion).nombre</td>
                            <td class="num">@consultorio.largo</td>
                            <td class="num">@consultorio.ancho</td>
                            <td class="num">@consultorio.area</td>
                            <td class="num"><button type="button" class="btn btn-sm" @onclick="() => ButtonOnClickQuitar(consultorio, 1)">Quitar</button></td>
                        </tr>
                    }}
            </tbody>
        </table>

        <fieldset class="ancho">
            <legend>
                Agregar consultorio de optometría
            </legend>
            <ValidationMessage For="() => _consultorios_opto.ubicacion" />
            <ValidationMessage For="() => _consultorios_opto.largo" />
            <ValidationMessage For="() => _consultorios_opto.ancho" />
            <ValidationMessage For="() => _consultorios_opto.area" />
            <div class="flex_agregar">
                <div>
                    <label for="ubicacion">Ubicación</label>
                    <InputSelect id="ubicacion" @bind-Value="_consultorios_opto.ubicacion">
                        <option value="">-</option>
                        @foreach (var item in _selectUbicaciones)
                        {
                            <option value="@item.id">@item.nombre</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="largo">Largo (m)</label>
                    <InputNumber id="largo" @bind-Value="_consultorios_opto.largo" />
                </div>
                <div>
                    <label for="ancho">Ancho (m)</label>
                    <InputNumber id="ancho" @bind-Value="_consultorios_opto.ancho" />
                </div>
                <div>
                    <label for="area">Área (m²)</label>
                    <InputNumber id="area" @bind-Value="_consultorios_opto.area" />
                </div>
                <div>
                    <button type="submit" class="boton-secundario">Añadir</button>
                </div>
            </div>
        </fieldset>
    </EditForm>

