                            <path d="M52.5137 14.8194C53.0438 15.5154 53.1741 16.4819 52.8829 17.5402L48.4946 33.4713C47.8105 35.9571 45.0531 38.058 42.4735 38.058H12.266C11.1682 38.058 10.2757 37.6769 9.75152 36.9858C9.2273 36.2938 9.10291 35.3312 9.40006 34.2749L12.418 23.5555C13.118 21.0696 15.8911 18.9688 18.4728 18.9688H28.0993C31.5645 18.9688 35.4651 17.714 36.2134 15.3209C36.4069 14.848 38.4406 13.7413 41.504 13.7413H49.9873C51.0881 13.7413 51.9845 14.1244 52.5137 14.8194Z" fill="#E6E6E6" />
                            <path d="M3.76591 4.15034C4.42637 3.38326 5.41558 2.95974 6.54991 2.95974H13.7271C16.6217 2.95974 18.5991 3.55208 19.071 3.88872C20.315 6.15147 25.8494 6.26796 26.9679 6.26796H38.0655C40.7734 6.26796 43.1438 7.64911 43.4538 8.88414L43.9296 10.7786H41.505C38.0388 10.7786 34.1392 12.0334 33.3909 14.4265C33.1964 14.8994 31.1627 16.0061 28.1003 16.0061H18.4738C14.5455 16.0061 10.6331 18.9688 9.56789 22.7509L7.79778 29.0405L3.00277 7.07849C2.83396 5.95797 3.10545 4.91742 3.76591 4.15034Z" fill="#E6E6E6" />
                        </svg>
                    </div>

                    <p class="m-0 text-gray-700 font-semibold">
                        No hay solicitudes que coincidan con tu búsqueda.
                    </p>

                    <p class="m-0 text-neutral-600">
                        Prueba ajustando los criterios de búsqueda o limpiando los filtros.
                    </p>

                    <button type="button" class="boton-secundario m-0" @onclick="LimpiarFiltrosAsync">
                        Limpiar filtros
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="w-full overflow-x-auto">
                <QuickGrid ItemsProvider="@pinesProvider"
                           @ref="grid"
                           Pagination="@pagination" class="table">

                    @switch (estado)
                    {
                        case nameof(EnumTipoConsultaPines.Activos):
                            break;
                    }
                    <TemplateColumn Title="Canal de venta" Context="c" Align="Align.Center">
                        @{
                            string nombreCanal = Enum.IsDefined(typeof(EnumOrigenCotizacion), c.CanalVenta)
                            ? ((EnumOrigenCotizacion)c.CanalVenta).ToString()
                            : "Desconocido";
                        }
                        @nombreCanal
                    </TemplateColumn>
                    <TemplateColumn Title="Número de PIN" Context="c" Align="Align.Center">
                        @if (c.CanalVenta == (int)EnumOrigenCotizacion.PortalAdministrativo)
                        {
                            <div class="tooltip tooltip-secondary" data-tip="Consultar detalles">
                                <NavLink href="@($"/compradepin/gestionarPin?pin={c.Pin}&tipoId={GetTipoIdentificacionInt(c.TipoIdentificacion)}&numeroId={c.NumeroIdentificacion}")">
                                    @(c.Pin)
                            </NavLink>
                            </div>
                        }
                        else
                        {
                            @(c.Pin)
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Modalidad" Context="c" Align="Align.Center">
                        @if (Convert.ToInt32(c.Cuotas) > 1)
                        {
                            @* Inicio código generado por GitHub Copilot *@
                            <div class="badge badge-info w-full">
                                <button type="button"
                                        class="btn btn-link m-0 p-0 font-normal"
                                        @onclick="async () => await modalPinesRef?.ShowWithPin(c.Pin, c.AgenteDispersion)">
                                    A Cuotas
                                </button>
                            </div>
                            @* Fin código generado por GitHub Copilot *@
                        }
                        else
                        {
                            <div class="badge badge-soft badge-neutral w-full">Único</div>
                        }
                    </TemplateColumn>
                    @* Inicio código generado por GitHub Copilot *@
                    @if (estado != nameof(EnumTipoConsultaPines.Devoluciones))
                    {
                        <PropertyColumn Title="Valor del centro" Property="@(c => (c.ValorActor ?? 0).ToString("C0", new CultureInfo("es-CO")))" Align="Align.Center" />
                    }
                    @* Fin código generado por GitHub Copilot *@
                    <TemplateColumn Title="@(estado == nameof(EnumTipoConsultaPines.Devoluciones) ? "Valor total a devolver" : "Valor total")" Context="c" Align="Align.Center">

                        <div class="tooltip tooltip-secondary" data-tip="Ver detalles">
                            <button class="btn btn-link m-0 h-fit p-0 text-base font-normal whitespace-nowrap"
                                    type="button"
                                    @onclick='async () => await ShowModal(c.Pin)'>
                                @(c.ValorTransaccion?.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-CO")))
                            </button>
                        </div>
                        @* Inicio código generado por GitHub Copilot *@
                        <DetalleTransaccionModal Id="@c.Pin" Estado="@estado" Item="@c" />
                        @* Fin código generado por GitHub Copilot *@
                    </TemplateColumn>
                    <PropertyColumn Title="Tipo Documento" Property="@(c => c.TipoIdentificacion)" Align="Align.Center" />
                    <PropertyColumn Title="Número de Documento" Property="@(c => c.NumeroIdentificacion)" Align="Align.Center" />
                    <PropertyColumn Title="Nombre completo" Property="@(c => c.NombreCompleto)" Align="Align.Center" />

                    @* Inicio código generado por GitHub Copilot *@
                    @switch (estado)
                    {
                        case nameof(EnumTipoConsultaPines.Activos):
                            @* Inicio código generado por GitHub Copilot *@
                            <TemplateColumn Title="Fecha de compra" Context="c" Align="Align.Center">
                                @{
                                    var fecha = c.FechaRegistro;
                                    var fechaFormateada = fecha.HasValue
                                    ? fecha.Value.ToString("dd/MM/yyyy - h:mm:ss tt", CultureInfo.InvariantCulture).ToLowerInvariant()
                                    : "Sin fecha";
                                }
                                <span class="tabular-nums whitespace-nowrap">@fechaFormateada</span>
                            </TemplateColumn>
                                    @* Fin código generado por GitHub Copilot *@
                                        break;
                                    case nameof(EnumTipoConsultaPines.Usados):
                            @* Inicio código generado por GitHub Copilot *@
                            <TemplateColumn Title="Fecha de uso" Context="c" Align="Align.Center">
                                @{
                                    var fecha = c.FechaRegistro;
                                    var fechaFormateada = fecha.HasValue
                                    ? fecha.Value.ToString("dd/MM/yyyy - h:mm:ss tt", CultureInfo.InvariantCulture).ToLowerInvariant()
                                    : "Sin fecha";
                                }
                                <span class="tabular-nums whitespace-nowrap">@fechaFormateada</span>
                            </TemplateColumn>

                                    <TemplateColumn Title="Fecha de dispersión" Context="c" Align="Align.Center">
                                        @{
                                            // Inicio refactorización/optimización por GitHub Copilot
                                            var fechaFormateada = DateTime.TryParse(c.FechaDispersion, out var parsedDispersion)
                                                ? parsedDispersion.ToString("dd/MM/yyyy - h:mm:ss tt", CultureInfo.InvariantCulture).ToLowerInvariant()
                                                : c.FDispersion.HasValue
                                                    ? c.FDispersion.Value.ToString("dd/MM/yyyy - h:mm:ss tt", CultureInfo.InvariantCulture).ToLowerInvariant()
                                                    : "-";
                                            // Fin refactorización/optimización por GitHub Copilot
                                        }
                                        <span class="tabular-nums whitespace-nowrap">@fechaFormateada</span>
                                    </TemplateColumn>
                        @* Fin código generado por GitHub Copilot *@
                            break;
                        case nameof(EnumTipoConsultaPines.Devoluciones):
                            @* Inicio código generado por GitHub Copilot *@
                            <TemplateColumn Title="Fecha de devolución" Context="c" Align="Align.Center">
                                @{
                                    var fecha = c.FechaDevolucion;
                                    var fechaFormateada = (!fecha.HasValue || fecha.Value == default)
                                        ? "-"
                                        : fecha.Value.ToString("dd/MM/yyyy - h:mm:ss tt", CultureInfo.InvariantCulture).ToLowerInvariant();
                            }
                            <span class="tabular-nums whitespace-nowrap">@fechaFormateada</span>
                        </TemplateColumn>
                        @* Fin código generado por GitHub Copilot *@
                            break;
                    }
                    @* Fin código generado por GitHub Copilot *@
                    <PropertyColumn Title="Código de transacción" Property="@(c => c.NUTVenta)" Align="Align.Center" />
                    <PropertyColumn Title="Centro de compra" Property="@(c => c.RazonSocial)" Align="Align.Center" />
                    <PropertyColumn Title="Aliado de recaudo" Property="@(c => c.AgenteDispersion)" Align="Align.Center" />

                </QuickGrid>
            </div>
        }
        @* Fin código generado por GitHub Copilot *@

        @* <Paginator State="@pagination" /> *@

        <div class="sticky left-0 m-0 grid grid-cols-[1fr_auto_1fr] items-baseline gap-6 py-3">
            @if (pagination.TotalItemCount.HasValue)
            {
                <div class="justify-self-start">
                    <strong>@pagination.TotalItemCount</strong> @(pagination.TotalItemCount == 1 ? "PIN encontrado" : "Pines encontrados")
                </div>

                <div class="justify-self-center">
                    @if (pagination.TotalItemCount > 1)
                    {
                        @if (pagination.LastPageIndex > 9)
                        {
                            <div class="join">
                                <button @onclick="@(() => GoFirstAsync())" class="btn join-item btn-sm text-neutral-700"
                                        aria-label="Ir a la primera página" disabled="@(!CanGoBack)">
                                    <svg class="feather size-4">
                                        <use xlink:href="assets/feather-sprite.svg#skip-back" />
                                    </svg>
                                </button>
                                <button @onclick="@(() => GoPreviousAsync())" class="btn join-item btn-sm text-neutral-700"
                                        aria-label="Ir a la página anterior" disabled="@(!CanGoBack)">
                                    <svg class="feather size-4">
                                        <use xlink:href="assets/feather-sprite.svg#chevron-left" />
                                    </svg>
                                </button>
                                <button class="btn join-item btn-sm pointer-events-none text-neutral-800" aria-label="Go to first page">
                                    Página @(pagination.CurrentPageIndex + 1) de @(pagination.LastPageIndex + 1)
                                </button>
                                <button @onclick="@(() => GoNextAsync())" class="btn join-item btn-sm text-neutral-700"
                                        aria-label="Ir a la página siguiente" disabled="@(!CanGoForwards)">
                                    <svg class="feather size-4">
                                        <use xlink:href="assets/feather-sprite.svg#chevron-right" />
                                    </svg>
                                </button>
                                <button @onclick="@(() => GoLastAsync())" class="btn join-item btn-sm text-neutral-700"
                                        aria-label="Ir a la última página" disabled="@(!CanGoForwards)">
                                    <svg class="feather size-4">
                                        <use xlink:href="assets/feather-sprite.svg#skip-forward" />
                                    </svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="join">
                                @for (var pageIndex = 0; pageIndex <= pagination.LastPageIndex; pageIndex++)
                                {
                                    var capturedIndex = pageIndex;
                                    <button @onclick="@(() => GoToPageAsync(capturedIndex))"
                                            class="join-item btn @PageButtonClass(capturedIndex)"
                                            aria-current="@AriaCurrentValue(capturedIndex)"
                                            aria-label="Go to page @(pageIndex + 1)">
                                        @(pageIndex + 1)
                                    </button>
                                }
                            </div>
                        }

                    }
                </div>
                <div class="flex flex-row items-baseline gap-2 justify-self-end">
                    <label for="items" class="font-medium whitespace-nowrap">Ítems por página</label>
                    <select id="items" @bind="@pagination.ItemsPerPage" class="w-max">
                        <option>10</option>
                        <option>15</option>
                        <option>20</option>
                        <option>25</option>
                    </select>
                </div>
            }
        </div>
    </figure>
</div>


