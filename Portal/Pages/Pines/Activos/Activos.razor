        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        margin: 0 auto !important;
    }

    .loading {
        --size-selector: .15rem !important;
        width: 50px !important;
        height: 50px !important;
    }
    @* Inicio código generado por GitHub Copilot *@
    .quickgrid thead th {
        background-color: #FFFFFF !important;
        color: #111827 !important;
    }

    .quickgrid tbody tr:nth-child(odd) td {
        background-color: #F9FAFB;
    }

    .quickgrid tbody tr:nth-child(even) td {
        background-color: transparent;
    }

    .modal-detalle-transaccion .modal-box {
        max-width: 430px !important;
        width: min(100%, 430px);
        overflow: visible !important;
    }

    @* Inicio código generado por GitHub Copilot *@
    .modal-detalle-transaccion .tooltip::before,
    .modal-detalle-transaccion .tooltip::after {
        z-index: 9999 !important;
    }
    @* Fin código generado por GitHub Copilot *@

    .quickgrid th,
    .quickgrid td {
        height: 40px !important;
        line-height: 1.15;
    }
    @* Fin código generado por GitHub Copilot *@

    @* Inicio código generado por GitHub Copilot *@
    .tooltip.tooltip-devolucion::before {
       
        background-color: #F9FAFB !important; /* gray-50 */
        border: 1px solid #E5E7EB !important; /* gray-200 */
        color: black;
    }

    .tooltip.tooltip-devolucion::after {
        background-color: #F9FAFB !important; /* gray-50 */
        border: 1px solid #E5E7EB !important; /* gray-200 */
    }
    @* Fin código generado por GitHub Copilot *@

    @* Inicio código generado por GitHub Copilot *@
    .modalidad-badge {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 8px;
        background-color: #CFE3FF; /* solicitado */
        color: #2563EB;
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1rem;
        white-space: nowrap;
    }
    @* Fin código generado por GitHub Copilot *@

</style>


@layout SingleLayout

<div class="mx-auto w-full max-w-full">

    <h3>Gestión de pines</h3>

    <div role="tablist" class="tabs tabs-border tabs-lg mb-3">
        @* Inicio código generado por GitHub Copilot *@
        @foreach (var estadoEnum in new[] {
            EnumTipoConsultaPines.Activos,
            EnumTipoConsultaPines.Usados,
            EnumTipoConsultaPines.Devoluciones
        })
        {
            var estadoInt = (int)estadoEnum;
            <NavLink class="tab no-underline font-semibold text-lg"
                     activeClass="tab-active"
                     href="@($"/pines/{estadoEnum}")"
                     role="tab">
                @estadoEnum
            </NavLink>
        }
        @* Fin código generado por GitHub Copilot *@
    </div>

    <div class="flex w-full items-center gap-3 mb-2 ml-2">
        <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
