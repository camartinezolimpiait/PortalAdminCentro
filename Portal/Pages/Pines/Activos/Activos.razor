            </g>
        </svg>
        <p class="max-w-full text-gray-700 mb-0">Elige un rango de fechas adecuado y utiliza los filtros para buscar por PIN, canal de venta, tipo de documento, número de documento o nombre del centro.</p>
    </div>

    <EditForm EditContext="@FiltrosEditContext" OnValidSubmit="HandleValidSubmitAsync">
        <AntiforgeryToken />
        <DataAnnotationsValidator />

        <div class="mb-4 w-fit">
            <div class="flex flex-row flex-wrap items-end gap-3">
                <div class="flex-auto grid grid-cols-2 gap-2 bg-neutral-100 p-2 rounded-md border border-neutral-300">
                    <div>
                        <label for="fechaInicial" class="text-sm">Fecha inicial</label>
                        <InputDate TValue="DateTime" id="fechaInicial"
                                   @bind-value="filtroFechaInicial"
                                   min="@filtroFechaFinal.AddDays(-90).ToString("yyyy-MM-dd")"
                                   max="@filtroFechaFinal.AddDays(-1).ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label for="fechaFinal" class="text-sm">Fecha final</label>
                        <InputDate TValue="DateTime" id="fechaFinal"
                                   @bind-value="filtroFechaFinal"
                                   min="@filtroFechaInicial.AddDays(+1).ToString("yyyy-MM-dd")"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="w-max flex-auto bg-neutral-100 p-2 rounded-md border border-neutral-300">
                    <label for="pin" class="text-sm">PIN</label>
                    <InputText id="pin" @bind-value="FiltrosModel.Pin" placeholder="Buscar PIN exacto" minlength=15 maxlength=15 />
                </div>

                <div class="w-max flex-auto bg-neutral-100 p-2 rounded-md border border-neutral-300">
                    <label for="canalVenta" class="text-sm">Canal de venta</label>
                    <InputSelect TValue="int" id="canalVenta" @bind-value="FiltrosModel.CanalVenta">
                        <option selected value=0>Todos</option>
                        @foreach (EnumOrigenCotizacion origen in Enum.GetValues(typeof(EnumOrigenCotizacion)))
                        {
                            <option value="@((int)origen)">@origen</option>
                        }
                    </InputSelect>
                </div>

                <div class="w-max flex-auto bg-neutral-100 p-2 rounded-md border border-neutral-300">
                    <label for="tipoDocumento" class="text-sm">Tipo de documento</label>
                    <InputSelect TValue="string" id="tipoDocumento" @bind-value="FiltrosModel.TipoDocumento">
                        <option value="">Todos</option>
                        @* Inicio refactorización/optimización por GitHub Copilot *@
                        @foreach (var doc in ListaDocumentos ?? [])
                        {
                            <option value="@doc.IdTipoSisec">@doc.Nombre</option>
                        }
                        @* Fin refactorización/optimización por GitHub Copilot *@
                    </InputSelect>
                </div>

                <div class="w-max flex-auto bg-neutral-100 p-2 rounded-md border border-neutral-300">
                    <label for="documento" class="text-sm">Nº Documento</label>
                    <InputText id="documento" @bind-value="FiltrosModel.Documento"  placeholder="Documento exacto" />
                    <ValidationMessage For="@(() => FiltrosModel.Documento)" />
                </div>

                <div class="w-max flex-auto bg-neutral-100 p-2 rounded-md border border-neutral-300">
                    <label for="recaudo" class="text-sm">Aliado de recaudo</label>
                    <InputSelect id="recaudo" class="max-w-full" @bind-Value="FiltrosModel.AliadoRecaudo">
                        <option value="">Todos</option>
                        <option value="@((int)EnumAliadoRecaudo.BANCOLOMBIA)">Bancolombia</option>
                        <option value="@((int)EnumAliadoRecaudo.COLPATRIA)">Colpatria</option>
                    </InputSelect>
                </div>

                <div class="w-sm flex-auto bg-neutral-100 p-2 rounded-md border border-neutral-300">
                    <label for="centro" class="text-sm">Centro o sede</label>
                    <InputSelect id="centro" class="max-w-full" TValue="string" @bind-Value="filtroCentroIdRunt">
                        <option value="">Todos</option>
                        @* Inicio refactorización/optimización por GitHub Copilot *@
                        @foreach (var centro in ListaCentros ?? [])
                        {
                            if (centro.CodigoRUNT.HasValue)
                            {
                                <option value="@centro.CodigoRUNT.Value.ToString()">@centro.Nombre</option>
                            }
                        }
                        @* Fin refactorización/optimización por GitHub Copilot *@
                    </InputSelect>
                </div>

                <button type="submit" class="boton-primario m-0">Filtrar</button>
            </div>
        </div>
    </EditForm>
    @* Inicio código generado por GitHub Copilot *@ 
    <div class="flex items-center justify-between mb-4">
        <h4 class="text-lg font-bold m-0">Resultados de la consulta</h4>
        <button class="boton-secundario flex items-center gap-2" type="button" @onclick="ExportarDatosAsync">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4" />
            </svg>
            Exportar datos
        </button>
    </div>
    @* Fin código generado por GitHub Copilot *@
    <figure class="relative m-0 w-full max-w-full">
        @* Inicio código generado por GitHub Copilot *@
        @if (SinResultados && HaHechoPrimeraConsulta)
        {
            <div class="w-full max-w-full rounded-md bg-gray-50 p-8" style="height: 450px;">
                <div class="mx-auto flex h-full max-w-2xl flex-col items-center justify-center text-center gap-3">
                    <div class="h-16 w-16">
                        @* Placeholder para ícono (reemplaza este SVG por tu imagen) *@
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="42" viewBox="0 0 56 42" fill="none">
