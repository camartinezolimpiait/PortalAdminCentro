@using System.Globalization
@using portalAdministrativoSISEC.Data.Pines
@using portalAdministrativoSISEC.Enum.PortalAdministrativo
@using portalAdministrativoSISEC.Util.Const.ApiPortalAdministrativo
@using portalAdministrativoSISEC.Enum
@using portalAdministrativoSISEC.Entidades.Devolucion

@* Inicio código generado por GitHub Copilot *@
<dialog id="@Id" class="modal font-sans modal-detalle-transaccion">
    <div class="modal-box bg-neutral-100 p-4 text-left" style="--op-row-y: 6px;">
        <div class="flex items-center justify-between text-center mb-3">
            <h3 class="text-lg font-bold text-gris-900 m-0">Detalles de la transacción</h3>

            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost text-neutral-600" aria-label="Cerrar modal">
                    <svg class="feather">
                        <use href="assets/feather-sprite.svg#x" />
                    </svg>
                </button>
            </form>
        </div>

        <div class="space-y-4">
            @if (Item is null)
            {
                <div class="text-center text-neutral-500">Sin información.</div>
            }
            else
            {
                @if (string.Equals(Item.AgenteDispersion, "BANCOLOMBIA", StringComparison.OrdinalIgnoreCase)
                    && Estado == nameof(EnumTipoConsultaPines.Devoluciones))
                {
                    <div class="space-y-2 rounded-md border border-neutral-300 bg-white p-4">
                        <div class="grid grid-cols-2 gap-x-2 gap-y-2 font-semibold">
                            <div class="text-neutral-600" style="padding-top: 3px; padding-bottom: 3px;">Estado de devolución</div>
                            <div class="text-right" style="padding-top: 3px; padding-bottom: 3px;">
                                @{
                                    var tieneFechaDevolucion = Item.FechaDevolucion.HasValue && Item.FechaDevolucion.Value != default;
                                    var estadoDevolucion = tieneFechaDevolucion ? "Pagado" : "Sin pagar";
                                    var bg = tieneFechaDevolucion ? "#16A34A" : "#B91C1C";
                                }
                                <span style="display: inline-flex; align-items: center; justify-content: center; padding: 2px 8px; border-radius: 8px; background-color: @bg; color: #FFFFFF; font-size: 0.75rem; font-weight: 600; line-height: 1rem; white-space: nowrap;">
                                    @estadoDevolucion
                                </span>
                            </div>
                        </div>
                    </div>
                }

                <div class="space-y-2 rounded-md border border-neutral-300 bg-white p-4">
                    <p style="row-gap: var(--op-row-y);" class="text-azul-700 text-base mb-3">Datos de la operación</p>
                    <div class="grid grid-cols-2 gap-x-2 gap-y-2 font-semibold" style="row-gap: var(--op-row-y);">
                        @if (Estado == nameof(EnumTipoConsultaPines.Devoluciones))
                        {
                            @* Inicio refactorización/optimización por GitHub Copilot *@
                            @if (Convert.ToInt32(Item.Cuotas) > 1)
                            {
                                <div class="tooltip tooltip-secondary gap-4 tooltip-devolucion:" data-tip="El valor de la devolución corresponde a la suma de las cuotas pagadas, menos la comisión del aliado de recaudo." style="row-gap: var(--op-row-y); --tt-bg: var(--color-gris-50); --color-secondary-content: var(--color-gris-900); --tt-border: 1px solid var(--color-gris-200);">
                                    <div class="flex items-center gap-1 text-neutral-600 whitespace-nowrap">
                                        <span class="leading-none">Valor total a devolver</span>
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 17 17" fill="none" aria-hidden="true" focusable="false">
                                            <path d="M7.5 12.5H9.16667V7.5H7.5V12.5ZM8.33333 5.83333C8.56944 5.83333 8.76736 5.75347 8.92708 5.59375C9.08681 5.43403 9.16667 5.23611 9.16667 5C9.16667 4.76389 9.08681 4.56597 8.92708 4.40625C8.76736 4.24653 8.56944 4.16667 8.33333 4.16667C8.09722 4.16667 7.89931 4.24653 7.73958 4.40625C7.57986 4.56597 7.5 4.76389 7.5 5C7.5 5.23611 7.57986 5.43403 7.73958 5.59375C7.89931 5.75347 8.09722 5.83333 8.33333 5.83333ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z" fill="#004AA1" />
                                        </svg>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-neutral-600" style="row-gap: var(--op-row-y);">Valor total a devolver:</div>
                            }
                            @* Fin refactorización/optimización por GitHub Copilot *@

                            <div class="text-right tabular-nums text-base">
                                @(Item.ValorTransaccion?.ToString("C0", CultureInfo.GetCultureInfo("es-CO")))
                            </div>
                        }

                        <div class="text-neutral-600 gap-4" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">
                            @(
                                Estado == nameof(EnumTipoConsultaPines.Activos) ? "Fecha de compra:" :
                                Estado == nameof(EnumTipoConsultaPines.Usados) ? "Fecha de uso:" :
                                Estado == nameof(EnumTipoConsultaPines.Devoluciones) ? "Fecha:" :
                                "Fecha:"
                            )
                        </div>

                        <div class="text-right tabular-nums gap-4" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">
                            @(Item.FechaRegistro.HasValue ? Item.FechaRegistro.Value.ToString("dd-MM-yyyy") : "Sin fecha")
                        </div>

                        @if (string.Equals(Item.AgenteDispersion, "BANCOLOMBIA", StringComparison.OrdinalIgnoreCase)
                            && Estado == nameof(EnumTipoConsultaPines.Devoluciones))
                        {
                            <div class="text-neutral-600" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">Tipo:</div>
                            <div class="text-right tabular-nums" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">@Item.TipoDevolucion</div>

                            <div class="text-neutral-600" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">Novedad:</div>
                            <div class="text-right tabular-nums" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">
                                @(string.IsNullOrWhiteSpace(Item.NovedadDevolucion) ? "Sin novedad" : Item.NovedadDevolucion)
                            </div>
                        }

                        @* Inicio código generado por GitHub Copilot *@

                        @if (Estado == nameof(EnumTipoConsultaPines.Devoluciones))
                        {
                            var esCuotas = Convert.ToInt32(Item.Cuotas) > 1;
                            var textoModalidad = esCuotas ? "A Cuotas" : "Único";
                            var bgModalidad = esCuotas ? "#CFE3FF" : "#E6E6E6";
                            var colorTextoModalidad = esCuotas ? "#2563EB" : "#6B7280"; // gray-500
                            var esTransferencia = string.Equals(Item.TipoDevolucion, "TRANSFERENCIA", StringComparison.OrdinalIgnoreCase);
                            var tieneFechaDevolucion = Item.FechaDevolucion.HasValue && Item.FechaDevolucion.Value != default;

                            <div class="col-span-2 flex items-center justify-between mt-2 gap-3">
                                <span class="modalidad-badge shrink-0" style="background-color: @bgModalidad; color: @colorTextoModalidad;">@textoModalidad</span>

                                @if (esTransferencia && tieneFechaDevolucion)
                                {
                                    <button type="button" class="boton-secundario flex items-center gap-2 ml-auto" @onclick="DescargarComprobanteAsync">
                                        <svg class="feather size-4" aria-hidden="true" focusable="false">
                                            <use href="assets/feather-sprite.svg#download" />
                                        </svg>
                                        Descargar comprobante
                                    </button>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                        @* Fin código generado por GitHub Copilot *@

                        @if (Estado == nameof(EnumTipoConsultaPines.Activos))
                        {
                            <div class="text-neutral-600" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">Aliado de recaudo:</div>
                            <div class="text-right tabular-nums" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">
                                @Item.AgenteDispersion
                            </div>

                            <div class="text-neutral-600" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">Código de transacción:</div>
                            <div class="text-right tabular-nums" style="padding-top: var(--op-row-y); padding-bottom: var(--op-row-y);">
                                @(string.IsNullOrWhiteSpace(Item.NUTVenta) ? "Sin código" : Item.NUTVenta)
                            </div>
                        }
                    </div>
                </div>


                @* Inicio código generado por GitHub Copilot *@
                @if (Estado == nameof(EnumTipoConsultaPines.Devoluciones)
                            && string.Equals(Item.TipoDevolucion, "TRANSFERENCIA", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="space-y-2 rounded-md border border-neutral-300 bg-white p-4">
                        <p class="text-azul-700 text-base">Información bancaria</p>
                        <div class="grid grid-cols-2 gap-x-2 gap-y-2 font-semibold">
                            <div class="text-neutral-600">Banco:</div>
                            <div class="text-right tabular-nums">@(string.IsNullOrWhiteSpace(Item.Banco) ? "Sin información" : Item.Banco)</div>

                            <div class="text-neutral-600">Cuenta de banco:</div>
                            <div class="text-right tabular-nums">@(string.IsNullOrWhiteSpace(Item.CuentaBanco) ? "Sin información" : Item.CuentaBanco)</div>
                        </div>
                    </div>
                }
                @* Fin código generado por GitHub Copilot *@

                @if (Estado == nameof(EnumTipoConsultaPines.Activos) || Estado == nameof(EnumTipoConsultaPines.Usados))
                {
                    <div class="space-y-2 rounded-md border border-neutral-300 bg-white p-4 mt-2">
                        <p class="text-azul-700 text-base">Desglose del pago</p>
                        <div class="grid grid-cols-2 gap-x-2 gap-y-3 font-semibold">
                            <div class="text-neutral-600">Valor ANSV:</div>
                            <div class="text-right tabular-nums">@Item.ValorAns?.ToString("C0", CultureInfo.GetCultureInfo("es-CO"))</div>
                            <div class="text-neutral-600">Valor SICOV:</div>
                            <div class="text-right tabular-nums">@Item.ValosSicov?.ToString("C0", CultureInfo.GetCultureInfo("es-CO"))</div>

                            @{
                                var esCuotas = Convert.ToInt32(Item.Cuotas) > 1;

                                var esColpatria = string.Equals(Item.AgenteDispersion, "COLPATRIA", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(Item.AgenteDispersion, "SCOTIABANK COLPATRIA", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(Item.AgenteDispersion, "SCOTIABANK", StringComparison.OrdinalIgnoreCase);

                                var esBancolombia = string.Equals(Item.AgenteDispersion, "BANCOLOMBIA", StringComparison.OrdinalIgnoreCase);

                                string? tooltipValorAliado = null;
                                if (esCuotas && esColpatria)
                                {
                                    tooltipValorAliado = "El valor del aliado se determina con base en las cuotas pagadas, lo que puede modificar el valor final.";
                                }
                                else if (esCuotas && esBancolombia)
                                {
                                    tooltipValorAliado = "El valor del aliado se calcula según la cantidad de cuotas definidas.";
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(tooltipValorAliado))
                            {
                                <div class="tooltip tooltip-secondary gap-4" data-tip="@tooltipValorAliado" style="--tt-bg: var(--color-gris-50); --color-secondary-content: var(--color-gris-900);">
                                    <div class="flex items-center gap-1 text-neutral-600 whitespace-nowrap">
                                        <span class="leading-none">Valor Aliado</span>
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 17 17" fill="none" aria-hidden="true" focusable="false">
                                            <path d="M7.5 12.5H9.16667V7.5H7.5V12.5ZM8.33333 5.83333C8.56944 5.83333 8.76736 5.75347 8.92708 5.59375C9.08681 5.43403 9.16667 5.23611 9.16667 5C9.16667 4.76389 9.08681 4.56597 8.92708 4.40625C8.76736 4.24653 8.56944 4.16667 8.33333 4.16667C8.09722 4.16667 7.89931 4.24653 7.73958 4.40625C7.57986 4.56597 7.5 4.76389 7.5 5C7.5 5.23611 7.57986 5.43403 7.73958 5.59375C7.89931 5.75347 8.09722 5.83333 8.33333 5.83333ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z" fill="#6B7280" />
                                        </svg>
                                        <span class="leading-none">:</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-neutral-600">Valor Aliado:</div>
                            }

                            <div class="text-right tabular-nums">@Item.ValorAliado?.ToString("C0", CultureInfo.GetCultureInfo("es-CO"))</div>

                            <div class="text-azul-700">Valor de centro:</div>
                            <div class="text-right tabular-nums text-azul-700">@Item.ValorActor?.ToString("C0", CultureInfo.GetCultureInfo("es-CO"))</div>
                            <div class="col-span-2 grid grid-cols-subgrid border-t border-neutral-300 pt-2">
                                @* Inicio código generado por GitHub Copilot *@
                                @if (Convert.ToInt32(Item.Cuotas) > 1
                                    && (
                                        string.Equals(Item.AgenteDispersion, "COLPATRIA", StringComparison.OrdinalIgnoreCase)
                                        || string.Equals(Item.AgenteDispersion, "SCOTIABANK COLPATRIA", StringComparison.OrdinalIgnoreCase)
                                        || string.Equals(Item.AgenteDispersion, "SCOTIABANK", StringComparison.OrdinalIgnoreCase)
                                    ))
                                {
                                    <div class="col-span-2 mb-2 flex items-center gap-2 text-sm text-neutral-600">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 17 17" fill="none" aria-hidden="true" focusable="false">
                                            <path d="M7.5 12.5H9.16667V7.5H7.5V12.5ZM8.33333 5.83333C8.56944 5.83333 8.76736 5.75347 8.92708 5.59375C9.08681 5.43403 9.16667 5.23611 9.16667 5C9.16667 4.76389 9.08681 4.56597 8.92708 4.40625C8.76736 4.24653 8.56944 4.16667 8.33333 4.16667C8.09722 4.16667 7.89931 4.24653 7.73958 4.40625C7.57986 4.56597 7.5 4.76389 7.5 5C7.5 5.23611 7.57986 5.43403 7.73958 5.59375C7.89931 5.75347 8.09722 5.83333 8.33333 5.83333ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z" fill="#6B7280" />
                                        </svg>
                                        <span>El valor total varía conforme el pago de las cuotas.</span>
                                    </div>
                                }
                                @* Fin código generado por GitHub Copilot *@

                                <div class="font-semibold">Valor total del PIN:</div>
                                <div class="text-right font-semibold tabular-nums">@Item.ValorTransaccion?.ToString("C0", CultureInfo.GetCultureInfo("es-CO"))</div>
                            </div>
                        </div>
                    </div>
                }

                @if (Estado == nameof(EnumTipoConsultaPines.Devoluciones))
                {
                    <div class="space-y-2 rounded-md border border-neutral-300 bg-white p-4">
                        <p class="text-azul-700 text-base">Datos del cliente</p>
                        <div class="grid grid-cols-2 gap-2 font-semibold" style="row-gap: var(--op-row-y);">
                            <div class="text-neutral-600" style="padding-top: 3px; padding-bottom: 3px;">Nombre completo:</div>
                            <div class="text-right" style="padding-top: 3px; padding-bottom: 3px;">@(string.IsNullOrWhiteSpace(Item.NombreCompleto) ? "Sin información" : Item.NombreCompleto)</div>

                            <div class="text-neutral-600" style="padding-top: 3px; padding-bottom: 3px;">Número de documento:</div>
                            <div class="text-right" style="padding-top: 3px; padding-bottom: 3px;">@(string.IsNullOrWhiteSpace(Item.NumeroIdentificacion) ? "Sin información" : Item.NumeroIdentificacion)</div>

                            <div class="text-neutral-600" style="padding-top: 3px; padding-bottom: 3px;">Correo:</div>
                            <div class="text-right min-w-0 break-all" style="padding-top: 3px; padding-bottom: 3px;">
                                @(string.IsNullOrWhiteSpace(Item.Correo) ? "Sin información" : Item.Correo)
                            </div>

                            <div class="text-neutral-600" style="padding-top: 3px; padding-bottom: 3px;">Fecha de registro:</div>
                            <div class="text-right tabular-nums" style="padding-top: 3px; padding-bottom: 3px;">@(Item.FechaRegistro.HasValue ? Item.FechaRegistro.Value.ToString("dd-MM-yyyy") : "Sin fecha")</div>
                        </div>
                    </div>
                }

            }
        </div>

        <p class="pt-4 text-center text-xs text-pretty text-neutral-600 mb-0">
            Presione ESC o haga clic afuera para cerrar
        </p>
    </div>

    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>
@* Fin código generado por GitHub Copilot *@

<style>
    /* Inicio código generado por GitHub Copilot */
    /* Borde para el contenido del tooltip solo en este componente */
    .modal-detalle-transaccion .tooltip[style*="--tt-border"]::before,
    .modal-detalle-transaccion .tooltip[style*="--tt-border"] > .tooltip-content {
        outline: var(--tt-border);
        outline-offset: -1px;
    }
    /* Fin código generado por GitHub Copilot */
</style>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter, EditorRequired] public string Estado { get; set; } = default!;
    [Parameter, EditorRequired] public ResponseInfoPinEstado? Item { get; set; }

    // Inicio código generado por GitHub Copilot
    [Inject] private portalAdministrativoSISEC.Services.MiLicencia.IMiLicenciaService MiLicenciaService { get; set; } = default!;
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    // Método generado por GitHub Copilot
    private async Task DescargarComprobanteAsync()
    {

        // Reglas de negocio equivalentes a `EventCallbackButtonClick`
        if (Item.CanalVenta == (int)EnumOrigenCotizacion.MiLicencia || Item.CanalVenta == (int)EnumOrigenCotizacion.PAO)
        {
            await MiLicenciaService.ShowNotificacion(portalAdministrativoSISEC.Enum.NotificationStatus.Info, "Por razones de seguridad, no podemos mostrar el comprobante de pago debido a que contiene información personal del usuario");
            return;
        }

        if (Item.CanalVenta != (int)EnumOrigenCotizacion.Centro)
        {
            await MiLicenciaService.ShowNotificacion(portalAdministrativoSISEC.Enum.NotificationStatus.Info, $"No se puede generar el comprobante para el origen de cotizacion del pin {PagoPinConst.DescripcionCanalVenta[(EnumOrigenCotizacion)Item.CanalVenta]}");
            return;
        }

        try
        {
            var pin = Item.Pin ?? string.Empty;

            var fileResult = await MiLicenciaService.ConsultarComprobanteDevolucion(new portalAdministrativoSISEC.Entidades.Devolucion.ConsultaComprobanteDevolucionRequest
            {
                Pin = pin,
                NumeroIdentificacion = Item.NumeroIdentificacion ?? string.Empty,
                IdOrigenCotizacion = (int)EnumOrigenCotizacion.Centro
            });

            if (string.IsNullOrWhiteSpace(fileResult?.Base64))
            {
                await MiLicenciaService.ShowNotificacion(portalAdministrativoSISEC.Enum.NotificationStatus.Info, "Devolución efectuada. Comprobante de pago en proceso de carga. Por favor, consulte nuevamente");
                return;
            }

            await JS.InvokeVoidAsync("saveAsFile", $"DEVOL_{pin}.pdf", fileResult.Base64);
        }
        catch (Exception ex)
        {
            await MiLicenciaService.ShowNotificacion(portalAdministrativoSISEC.Enum.NotificationStatus.Error, $"Ha ocurrido un error: {ex.Message}");
        }
    }
