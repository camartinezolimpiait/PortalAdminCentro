
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.QuickGrid.Infrastructure
@using portalAdministrativoSISEC.Pages.Common
@inherits LayoutComponentBase
@layout Pines
@using portalAdministrativoSISEC.Pages.Pines.Busqueda

	

	<div>
			<h3>Pines Usados</h3>
			<Busqueda tipoBusqueda="2" DatosFiltros="DatosFiltros" DatosFiltrosChanged="DatosFiltrosChanged" DescargarDatos="DescargarDatos"></Busqueda>
			<SpinLoader IsLoading="isLoading">
			<LoadingTemplate>
				<div style="height:100%;display:flex">
					<br />
					<Circle Center="true" Color="var(--color-azul-600)"></Circle>
				</div>
			</LoadingTemplate>
			<ContentTemplate>
				@if(Listado.Count>0){
				<DynamicQuickGrid Data="Data" Columns="columnas" Pagination="Pagination" Paginas="PruebaPaginas" PaginaChanged="paginaChanged" View="Usados"></DynamicQuickGrid>
			}
		</ContentTemplate>
			</SpinLoader>
	</div>
	<script>
		window.downloadFileFromStream = async (fileName, contentStreamReference) => {
			const arrayBuffer = await contentStreamReference.arrayBuffer();
			const blob = new Blob([arrayBuffer]);
			const url = URL.createObjectURL(blob);
			const anchorElement = document.createElement('a');
			anchorElement.href = url;
			anchorElement.download = fileName ?? '';
			anchorElement.click();
			anchorElement.remove();
			URL.revokeObjectURL(url);
		}
	</script>


