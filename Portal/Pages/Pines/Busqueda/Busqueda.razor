                <div style="text-align:right">
                    <div class="dropdown">
                        <label class="dropdown-btn">Criterios de búsqueda</label>
                        <div class="dropdown-content">
                            <ul>
                                <li>&#8226; Fecha Inicial + Fecha Final + Centro</li>
                                <li>&#8226; Fecha Inicial + Fecha Final + Centro + Canal de Venta</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <fieldset class="ancho">
                    <div class="tres_columnas">
                        <div>
                            <label>Fecha Inicial</label>
                            <input type="date" name="FechaInicial" placeholder="DD/MM/AAAA" autocomplete="off" id="FechaInicial" @bind-value:event="oninput" @bind-value="busquedaPines.FechaInicial" max="@fechaAyerFormateada" />
                        </div>
                        <div>
                            <label>Fecha Final</label>
                            <input type="date" name="FechaFinal" placeholder="MM/DD/AAAA" autocomplete="off" id="FechaFinal" @bind-value:event="oninput" @bind-value="busquedaPines.FechaFinal" max="@fechaFormateada" />
                        </div>
                        <div>
                            <label>Nombre del Centro (*)</label>
                            <select id="nombreCentro"
                                    @bind-value:event="oninput"
                                    @bind-value="busquedaPines.IdRunt"
                                    class="@(string.IsNullOrEmpty(busquedaPines.IdRunt) ? "invalid-select" : "")">
                                <option value="">Seleccione un centro</option>
                                @foreach (var doc in ListaCentros)
                                {
                                    <option value="@doc.CodigoRUNT" selected="@(doc.CodigoRUNT.ToString() == busquedaPines.IdRunt ? true : false)">
                                        @doc.Nombre
                                    </option>
                                }
                            </select>
                        </div>

                    </div>
                    <div class="cinco_columnas">
                        @* <div>
                    <label>Canal de Venta</label>
                    <select id="canalVenta" @bind-value:event="oninput" @onchange="ActualizarCampos" @bind-value="busquedaPines.Canal">
                    <option value="">Seleccione un canal de venta</option>
                    @foreach (var doc in ListaCanalVenta)
                    {
                    <option value="@doc.Id" selected="@(doc.Id == busquedaPines.Canal ? true : false)">@doc.Nombre</option>
                    }
                    </select>
                    </div>
                    <div>
                    <label>Agente Dispersi&oacute;n</label>
                    <select id="agenteDispersion" @bind-value:event="oninput" @bind-value="busquedaPines.IdAgenteDispersion">
                    <option value="">Seleccione un agente</option>
                    @foreach (var doc in ListaAgenteDispersion)
                    {
                    <option value="@doc.IdAgenteDispersion" selected="@(doc.IdAgenteDispersion == busquedaPines.IdAgenteDispersion? true : false)">@doc.Nombre</option>
                    }
                    </select>
                    </div>
                    <div>
                    <label for="tipodocumento">Tipo Documento</label>
                    <select id="tipoDocumento" @bind-value:event="oninput" @bind-value="busquedaPines.IdTipoDocumento" disabled="@camposDeshabilitados">
                    <option value="">Seleccione un tipo de documento</option>
                    @foreach (var doc in ListaDocumentos)
                    {
                    <option value="@doc.IdTipoSisec" selected="@(int.Parse(doc.IdTipoSisec) == busquedaPines.IdTipoDocumento? true : false)">@doc.Nombre</option>
                    }
                    </select>
                    </div>
                    <div>
                    <label for="documento">Num. Documento</label>
                    <input inputmode="text" maxlength="20" type="text" id="documento" style="text-transform: uppercase;" autocomplete="off" @bind-value:event="oninput" @bind-value="busquedaPines.Documento" disabled="@camposDeshabilitados" />
                    </div>
                    <div>
                    <label for="pin">Num. Pin</label>
                    <input inputmode="text" maxlength="30" type="text" id="pin" style="text-transform: uppercase;" autocomplete="off" @bind-value:event="oninput" @bind-value="busquedaPines.Pin" />
                    </div> *@
                    </div>
                    <div style="text-align:right" class="mt-4">
                        <button class="boton-primario" @onclick="()=> DescargarArchivo(true, busquedaPines)">
                            <em class="fa fa-download"></em>
                        </button>
                        <button class="boton-primario" @onclick="()=> ConsultarPines(busquedaPines)">
                            <em class="fa fa-search mr-2"></em> Consultar
                        </button>
                    </div>
                </fieldset>
            </div>
        }
