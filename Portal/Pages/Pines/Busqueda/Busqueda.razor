    <script type="text/javascript">
            window.preventDefaultKeyPress = function (key) {
                document.addEventListener('keydown', function preventKeyPress(event) {
                    if (event.key === key) {
                        event.preventDefault();
                    }
                    document.removeEventListener('keydown', preventKeyPress);
                }, { once: true });
            }
        </script>
    </ContentTemplate>
</SpinLoader>


