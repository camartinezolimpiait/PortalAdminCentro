@inject NavigationManager NavManager
@using System.Globalization;

<h3 class="">Detalles de la compra</h3>

<div class="max-w-xl mt-3 space-y-4 font-sans">

    <!-- Mensaje dinámico -->
    @if (compraRealizada)
    {
        <div class="flex items-center gap-2 border border-green-400 bg-green-50 rounded-md px-4 py-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 30 30" fill="none">
                <path d="M15 0C23.2843 0 30 6.71573 30 15C30 23.2843 23.2843 30 15 30C6.71573 30 0 23.2843 0 15C0 6.71573 6.71573 0 15 0ZM13 21L22 12L20.5858 10.5858L13 18.1716L9.41421 14.5858L8 16L13 21Z" fill="#2E7D32" />
            </svg>
            <p class="text-gray-800 text-lg ml-1 mb-0 font-bold leading-tight">
                El abono al número de PIN
                <span class="font-semibold text-blue-700 hover:underline cursor-pointer">@InfoPin.Entidad.Pin</span>
                ha sido exitoso
            </p>
        </div>
    }
    else
    {
        <div class="flex items-center gap-2 border border-red-400 bg-red-50 rounded-md px-4 py-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">
                <path d="M15 17.2263L18.8271 21.053C19.1298 21.356 19.5007 21.5041 19.9399 21.4974C20.3793 21.4905 20.7503 21.3357 21.053 21.033C21.356 20.73 21.5074 20.359 21.5074 19.9199C21.5074 19.4807 21.356 19.1097 21.053 18.8067L17.2263 15L21.053 11.1729C21.356 10.8702 21.5074 10.4993 21.5074 10.0601C21.5074 9.62072 21.356 9.24968 21.053 8.94697C20.7503 8.64403 20.3793 8.49256 19.9399 8.49256C19.5007 8.49256 19.1298 8.64403 18.8271 8.94697L15 12.7737L11.1729 8.94697C10.8702 8.64403 10.5026 8.49256 10.0701 8.49256C9.63766 8.49256 9.26995 8.64403 8.96701 8.94697C8.66431 9.24968 8.51295 9.62072 8.51295 10.0601C8.51295 10.4993 8.66431 10.8702 8.96701 11.1729L12.7737 15L8.94697 18.8271C8.64403 19.1298 8.4959 19.4974 8.50258 19.9299C8.50949 20.3623 8.66431 20.73 8.96701 21.033C9.26995 21.3357 9.641 21.487 10.0801 21.487C10.5193 21.487 10.8903 21.3357 11.1933 21.033L15 17.2263ZM15 30C12.9123 30 10.9574 29.6075 9.13518 28.8225C7.31299 28.0372 5.72742 26.9702 4.37849 25.6215C3.02979 24.2726 1.96281 22.687 1.17754 20.8648C0.392515 19.0426 0 17.0877 0 15C0 12.9123 0.392515 10.9574 1.17754 9.13518C1.96281 7.31299 3.02979 5.72742 4.37849 4.37849C5.72742 3.02979 7.31299 1.96281 9.13518 1.17754C10.9574 0.392514 12.9123 0 15 0C17.0877 0 19.0426 0.392514 20.8648 1.17754C22.687 1.96281 24.2726 3.02979 25.6215 4.37849C26.9702 5.72742 28.0372 7.31299 28.8225 9.13518C29.6075 10.9574 30 12.9123 30 15C30 17.0877 29.6075 19.0426 28.8225 20.8648C28.0372 22.687 26.9702 24.2726 25.6215 25.6215C24.2726 26.9702 22.687 28.0372 20.8648 28.8225C19.0426 29.6075 17.0877 30 15 30Z" fill="#E61B14" />
            </svg>
            <p class="text-gray-800 text-lg ml-1 mb-0 font-bold leading-tight">
                El abono al número de PIN
                <span class="font-semibold text-blue-700 hover:underline cursor-pointer">@InfoPin.Entidad.Pin</span>
                ha sido fallido
            </p>
        </div>
    }

    <!-- Información general -->
    <div class="border border-gray-200 rounded-md bg-white shadow-sm p-4">
        <h4 class="text-azul-800 font-bold mb-3 text-md">Información de la compra</h4>

        <div class="grid grid-cols-2 gap-y-2 text-gray-700 text-sm">
            <span class="font-semibold text-gray-800">Estado transacción</span>
            <span class="text-right font-semibold @(compraRealizada ? "text-green-600" : "text-red-600")">
                @(compraRealizada ? "Aprobada" : "Rechazada")
            </span>

            <span class="font-semibold text-gray-800">NUT</span>
            <span class="text-right">@Pago.Nut</span>

            <span class="font-semibold text-gray-800">Descripción</span>
            <span class="text-right">Licencia de conducción</span>

            <span class="font-semibold text-gray-800">Valor de pago</span>
            <span class="text-right font-medium">@ValorCompra.ToString("C0", CultureInfo.CreateSpecificCulture("es-CO"))</span>

            <span class="font-semibold text-gray-800">Fecha de pago</span>
            <span class="text-right">
                @(!string.IsNullOrEmpty(Pago.FechaPago)
                                ? Pago.FechaPago
                                : DateTime.Now.ToString("dd/MM/yyyy"))
            </span>
        </div>

        @if (!compraRealizada)
        {
            <div class="mt-4 border-t border-gray-200 pt-2">
                <p class="text-sm font-semibold text-red-600 mb-0">Detalle</p>
                <p class="text-sm text-red-600 mb-0">@Pago.Respuesta.Respuesta</p>
            </div>
        }
    </div>

    <div class="flex justify-end">
        <button class="boton-primario" @onclick="VolverAlInicio">
            Volver al inicio
        </button>
    </div>
</div>

