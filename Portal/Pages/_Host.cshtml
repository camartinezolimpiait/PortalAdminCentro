        function BlazorDownloadFile(fileName, contentType, byteArray) {
            const link = document.createElement('a');
            link.download = fileName;
            link.href = URL.createObjectURL(new Blob([new Uint8Array(byteArray)], { type: contentType }));
            document.body.appendChild(link);
