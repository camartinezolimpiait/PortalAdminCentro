    <script type='text/javascript'>
        // ✅ Definir en window explícitamente y verificar grecaptcha
        window.runCaptcha = function (actionName) {
            return new Promise((resolve, reject) => {
                // ✅ Verificar si grecaptcha está disponible
                if (typeof grecaptcha === 'undefined') {
                    resolve(null); // Retorna null en lugar de error
                    return;
                }

                try {
                    grecaptcha.ready(function () {
                        grecaptcha.execute('6Ldh-yUhAAAAAJ_Bc4FseTL8osPdpXxVAAUiI_p1', { action: actionName })
                            .then(function (token) {
                                resolve(token);
                            })
                            .catch(function (error) {
                                reject(error);
                            });
                    });
                } catch (error) {
                    resolve(null); // Resolver con null para no romper la app
                }
            });
        };
    </script>

