    private async Task<string> ObtenerImagenBrother()
    {
        string keyImagen = string.Empty;
        string[] strIdHuella;
        Http = new HttpClient();
        var apiName = "/CapturarImagenBrother";
        Http.BaseAddress = new Uri(@Configuration["AppSettings:uriSisecAgente"]);
        var response = await Http.GetAsync(apiName);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            strIdHuella = content.Split('|');
            if (!strIdHuella[0].Contains("Error"))
            {
                keyImagen = strIdHuella[1];
            }

        }
        return keyImagen;
    }



