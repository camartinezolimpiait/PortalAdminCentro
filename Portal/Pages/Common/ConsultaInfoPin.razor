@inject NavigationManager NavManager

<EditForm EditContext="EditContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-4 w-full max-w-full rounded-md border border-neutral-300 bg-neutral-100 p-3">
        <div class="flex flex-wrap md:flex-nowrap items-end gap-3">
            <div class="flex-1 min-w-[200px]">
                <label for="tipodoc" class="mb-0.5 block font-semibold">Tipo de Documento</label>
                <InputSelect id="tipodoc" @bind-Value="ConsultaDevolucionesModel.TipoDocumento"
                             class="w-full min-w-0">
                    <option value="" disabled selected>Seleccione un tipo de documento</option>
                    @foreach (var doc in ListaDocumentos)
                    {
                        <option value="@doc.IdTipoSisec">@doc.Nombre</option>
                    }
                </InputSelect>
            </div>

            <div class="flex-1 min-w-[200px]">
                <label for="numdoc" class="mb-0.5 block font-semibold">Número de documento</label>
                <InputText id="numdoc" @bind-Value="ConsultaDevolucionesModel.Documento"
                           maxlength="24" class="uppercase w-full min-w-0" />
            </div>

            <div class="flex-1 min-w-[200px]">
                <label for="pin" class="mb-0.5 block font-semibold">PIN</label>
                <InputText id="pin" @bind-Value="ConsultaDevolucionesModel.Pin"
                           maxlength="15" class="w-full min-w-0" />
            </div>

            <div class="flex w-full md:w-auto justify-start md:justify-end">
                <button type="submit" class="boton-primario box-border h-9 m-0 w-full md:w-auto md:min-w-[126px]">
                    Consultar
                </button>
            </div>

        </div>

    </div>
</EditForm>
