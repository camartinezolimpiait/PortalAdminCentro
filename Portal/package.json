{
  "scripts": {
    "dev": "npm run dev:css & dotnet watch run",
    "dev:css": "tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/app.css --watch",
    "build:css": "tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/app.css",
    "release:css": "tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/app.css --minify"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  },
  "volta": {
    "node": "22.18.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "daisyui": "^5.0.50"
  }
}
